// =================================================================================================
// Spell checking -- what the EDITOR flags, and the vocabulary that stops it flagging the domain.
//
// WHY THIS FILE EXISTS. This repository comments heavily: the migrations, the Helm chart and the
// READMEs are largely prose. That is a deliberate choice made elsewhere, and this file is its cost.
// Without it the Code Spell Checker extension reports several thousand problems across the tree,
// ALL of them false positives -- which does not merely annoy, it hides the real ones. A checker
// nobody believes is a checker nobody reads, and that is the state this file ends.
//
// NOTHING HERE SUPPRESSES A REAL MISSPELLING. At the time of writing there were none in this
// repository's own prose. Three exist in text copied VERBATIM from ASHRAE 223P
// ("Depiciton", "differentate", "tranforms") and must stay, because one of them is in an asset
// filename the standard itself ships; they are excluded by the vocabulary rule below rather than
// added as words, so the same typos elsewhere would still be caught. `telemetry_retenton_days` is
// deliberate and marked `(sic)` where it appears -- it is an EXAMPLE of a mistyped setting key.
//
// -------------------------------------------------------------------------------------------------
// THE THREE MECHANISMS, in the order to reach for them:
//
//   1. `language` -- en-GB alongside en. This project writes "behaviour", "organisation",
//      "authorised", "artefacts". Those are house style, not errors, and a US-only dictionary
//      flagged every one of them.
//   2. `ignorePaths` -- files whose content nobody wrote. Build output, backups, vendored schemas.
//   3. `words` -- the project's actual vocabulary. LOWERCASE, because a lowercase entry matches
//      every capitalisation: one `mqtt` covers MQTT, Mqtt and mqtt, which is why this list is 596
//      entries rather than the 736 the checker first reported.
//
// ADDING A WORD IS THE LAST RESORT, NOT THE FIRST. If the checker flags something new, read it
// first: it is a typo often enough to be worth the two seconds. Add it here only once you are sure,
// and add it in lowercase.
//
// PREFER THE WHOLE COMPOUND OVER THE FRAGMENT. cspell splits identifiers on case boundaries, so
// `PostgREST` was reported as an unknown `Postg`, and `columns`, `boolean` and `extension` as
// `olumns`, `oolean` and `xtension` where they follow one. Listing `postgrest` resolves all of
// those, because the checker tries the full word before it splits. Listing `postg` would have
// whitelisted a genuine misspelling of that shape instead, so it is not listed.
//
// EIGHT FRAGMENTS ARE LISTED ANYWAY, each because the source really does contain that fragment and
// is right to: `polic` from the parenthetical `polic(ies)`, `passw` from the literal `Passw0rd!`,
// `orize` from the package `oauth2orize`, `metr` from a quoted search prefix, `rearrang` from the
// partial regex `/Rearrang/i` in a test matcher, `indistinguish` from a hyphenated line break,
// `unre` from the coinage "unre-verified", and `retenton` from `telemetry_retenton_days`.
// =================================================================================================
{
  "version": "0.2",

  // en-GB SECOND, NOT INSTEAD OF en. Both dictionaries load: the codebase is British in its prose
  // and unavoidably American in its identifiers (`color`, `serialize`, `normalized` all appear in
  // library APIs), and dropping `en` would trade one class of false positive for another.
  "language": "en,en-GB",

  // -----------------------------------------------------------------------------------------------
  // Files nobody in this repository wrote the words in.
  //
  // `frontend/dist/**` ALONE ACCOUNTED FOR 4,400 PROBLEMS -- a bundled model-viewer whose minified
  // identifiers and embedded wasm read as thousands of unique "words". Checking generated output
  // says nothing about anything a person could fix.
  // -----------------------------------------------------------------------------------------------
  "ignorePaths": [
    "node_modules/**",
    "**/node_modules/**",
    ".git/**",
    "**/dist/**",
    "**/build/**",
    "backups/**",
    "**/*.min.js",
    "**/*.map",
    "**/package-lock.json",
    // Third-party specifications carried verbatim. AAS_V3_0_JSON_Schema.json is IDTA's, and its
    // property names are not ours to spell differently.
    "test-harness/schemas/**",
    // Binary and near-binary. The .gz entry matters most: the chart carries the migration chain as
    // one gzip per file, and reading those as text produces noise proportional to the schema.
    "**/*.gz", "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.svg", "**/*.ico",
    "**/*.pdf", "**/*.glb", "**/*.stl", "**/*.woff", "**/*.woff2",
    // Credentials, and a permission allowlist that is a log of shell commands rather than prose.
    ".env", ".env.*",
    ".claude/settings.local.json",
    // GENERATED PROTOBUF. `protoc` inlines the serialised descriptor as one 6,000-character string
    // literal, and the checker reads fragments of it as words -- `loat`, `oolean`, `ytes`, which are
    // the tails of "float", "boolean" and "bytes" in the Sparkplug B schema. Nothing there is
    // written by hand and nothing there is fixable.
    "**/*_pb2.py",
    // THIS FILE, which necessarily names the misspellings it exists to explain -- three from ASHRAE
    // and the compound fragments in the header. Checking it would report every one of them.
    "cspell.json"
  ],

  // -----------------------------------------------------------------------------------------------
  // Text that is data rather than language.
  // -----------------------------------------------------------------------------------------------
  "ignoreRegExpList": [
    // THE SEEDED VOCABULARIES, which are ontology prose copied verbatim from ASHRAE 223P, OPC UA,
    // MTConnect and ISO 22400. 1,322 such lines in 0002_seed_data.sql alone. They are quoted
    // standards text: this repository does not get to correct their spelling, and should not be
    // asked about it on every run. Scoped to the INSERT lines so the rest of the migration -- which
    // IS ours -- stays checked.
    "/INSERT INTO public\\.[a-z0-9_]*vocabulary VALUES .*/g",
    // JWTs, hex secrets, publishable/secret API keys and base64 blobs. Committed demo values in
    // .env.example and the dev chart values, plus every key this repository documents by example.
    "/eyJ[A-Za-z0-9_.-]+/g",
    "/\\b[0-9a-f]{16,}\\b/g",
    "/\\bsb_(publishable|secret)_[A-Za-z0-9_-]+/g",
    "/\\b[A-Za-z0-9+/]{40,}={0,2}\\b/g"
  ],

  // -----------------------------------------------------------------------------------------------
  // The project's vocabulary. Lowercase; see the header.
  //
  // Roughly: the stack's components (supabase, postgrest, gotrue, mosquitto, timescaledb, envoy),
  // Postgres catalog columns the migrations query by name (attrelid, relnamespace, polqual),
  // Sparkplug B and MQTT protocol terms (dbirth, ncmd, connack, suback), the industrial standards
  // this platform speaks (ashrae, opcua, mtconnect, qudt, irdi, packml, modbus), and the words this
  // repository coins for its own ideas (unauditable, unprobeable, greppable, requarantine).
  // -----------------------------------------------------------------------------------------------
  "words": [
    "aaaabbbbccccdddd", "aasenv", "aasx", "acao", "aclexplode", "acreateserial", 
