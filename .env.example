# =============================================================================
# Factory+ Asset Tracking Environment Configuration Example
# Copy this file to .env and adjust values for your local or production setup.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Self-Hosted Backend-as-a-Service (BaaS) Configuration
# Consumed by docker-compose.yml (supabase-db, supabase-auth, supabase-rest,
# supabase-kong, supabase-studio), frontend build, and Python ingestion.
# POSTGRES_PASSWORD configures the database password for the postgres superuser
# and least-privilege scoped database roles (supabase_auth_admin for GoTrue, authenticator for PostgREST).
POSTGRES_PASSWORD=postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiZXhwIjoyMDAwMDAwMDAwfQ.Z7KTfqo7mvr4j40uB-6K4f_VVT-d-ISkJ7E5VJ41jt0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJleHAiOjIwMDAwMDAwMDB9.GWSHLKn253lfP0FAYobjuXvQkQGcYhKVJ6Y0IJOo-lA
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
KONG_HTTP_PORT=54321
SUPABASE_DB_PORT=54322
STUDIO_PORT=54323

# -----------------------------------------------------------------------------
# Standalone TimescaleDB Configuration (Telemetry Hypertable)
# -----------------------------------------------------------------------------
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Grafana Administration
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# MQTT Broker Configuration
# -----------------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=factoryplus
MQTT_PASSWORD=factoryplus123

# -----------------------------------------------------------------------------
# Node-RED Edge Runtime
# -----------------------------------------------------------------------------
NODERED_CREDENTIAL_SECRET=factoryplussecret
