# =============================================================================
# ACS-Cymru Asset Tracking Environment Configuration Example
#
# ⚠️  EVERY SECRET IN THIS FILE IS PUBLISHED. Do not copy it to .env.
#
#     node scripts/setup.mjs        <- generates a fresh, matching credential set
#     node scripts/setup.mjs --demo <- copies this file verbatim (CI only)
#
# The Supabase keys below are the standard self-host demo values: they appear in this repository,
# in Supabase's own documentation, and in every other self-host guide on the internet. Since Kong
# began running `key-auth`, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are also registered as
# GATEWAY API KEYS — so a stack running these accepts published credentials at its edge. The four
# MQTT principals below all carry `acscymru123`; each is confined by mosquitto.acl, but a known
# password on the simulator's account still lets anyone forge telemetry for that one edge node.
#
# THE THREE SUPABASE VALUES ARE A SET. The anon and service-role keys are HS256 JWTs *signed by*
# SUPABASE_JWT_SECRET. Rotating the secret by hand without re-minting both leaves a stack that
# comes up entirely healthy and rejects every request at the gateway, which is why setup.mjs mints
# them together rather than telling you to run three openssl commands.
#
# This file remains the CI fixture — a pipeline needs identical credentials on every run, and
# deploy/helm/acs-cymru/values-dev.yaml carries the same set for the same reason.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Self-Hosted Backend-as-a-Service (BaaS) Configuration
# Consumed by docker-compose.yml (supabase-db, supabase-auth, supabase-rest,
# supabase-kong, supabase-studio), frontend build, and Python ingestion.
# POSTGRES_PASSWORD configures the database password for the postgres superuser
# and least-privilege scoped database roles (supabase_auth_admin for GoTrue, authenticator for PostgREST).
POSTGRES_PASSWORD=postgres
SUPABASE_URL=http://127.0.0.1:54321

# The BROWSER-facing Supabase address, where SUPABASE_URL above is the one containers use.
#
# The two differ whenever the stack is not being driven from the host it runs on: a browser cannot
# resolve `supabase-kong`, and a container's `127.0.0.1` is itself. Empty means "same as
# SUPABASE_URL", which is correct for a laptop and wrong for anything else.
#
# Added to this template by the finding described above MQTT_PUBLIC_HOST.
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiZXhwIjoyMDAwMDAwMDAwfQ.Z7KTfqo7mvr4j40uB-6K4f_VVT-d-ISkJ7E5VJ41jt0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJleHAiOjIwMDAwMDAwMDB9.GWSHLKn253lfP0FAYobjuXvQkQGcYhKVJ6Y0IJOo-lA
# The ingestion daemon's own credential (see Machine Identities in supabase/README.md). Unlike the two above it names a
# PRINCIPAL: `role: authenticated` with `sub` = b0000000-0000-4000-8000-000000000002, the
# Service_Ingestor identity seeded by migration 0046. It holds Operator, so it cannot write a
# single row directly -- every write goes through a SECURITY DEFINER gate in 0047 that checks the
# caller is this principal.
#
# It does NOT replace SUPABASE_ANON_KEY for the daemon, which still needs it: the gateway's apikey
# check admits exactly two literal keys, so this token is refused at the edge if sent as the
# apikey. It travels as the Authorization bearer instead.
SUPABASE_INGESTION_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhdXRoZW50aWNhdGVkIiwic3ViIjoiYjAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAyIiwiZXhwIjoyMDAwMDAwMDAwfQ.j-rSyTImEPP3Etuq304tYycMSKrk0mxcI_9Pmew3seI
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
# Used by postgres-meta to encrypt stored connection strings, and by Supabase Studio
# to talk to it. Both services must be given the same value.
PG_META_CRYPTO_KEY=acs-cymru-pg-meta-crypto-key
KONG_HTTP_PORT=54321
SUPABASE_DB_PORT=54322
STUDIO_PORT=54323

# Swagger UI interactive API reference (docs/openapi.yaml + live PostgREST schema).
# Changing this port also requires updating the CORS origins in supabase/kong.yml.
SWAGGER_PORT=8088

# -----------------------------------------------------------------------------
# Supabase Realtime (WebSocket change feed, consumed by supabase-realtime)
# REALTIME_DB_ENC_KEY must be EXACTLY 16 characters and REALTIME_SECRET_KEY_BASE
# at least 64 -- the container refuses to boot otherwise.
# These are local-dev demo values, as with the JWT keys above. Generate real ones:
#   openssl rand -hex 8     -> 16 chars
#   openssl rand -hex 32    -> 64 chars
# -----------------------------------------------------------------------------
REALTIME_DB_ENC_KEY=supabaserealtime
REALTIME_SECRET_KEY_BASE=8f2c1d4b7a9e0356c8b1f4d72e5a90c3b6d8f1a4e7c025d9a3e6b8c1f4d7a0e39

# -----------------------------------------------------------------------------
# Frontend feature flags
#
# ON THE COMPOSE PATH these are baked into the bundle at build time by frontend/Dockerfile, so
# changing one requires `docker compose up --build frontend`, not a restart. Vite inlines
# import.meta.env when the bundle is built and there is nothing to re-read at runtime.
#
# ON THE KUBERNETES PATH the same image is built with VITE_RUNTIME_CONFIG=true and reads these
# from a ConfigMap mounted at /config.js instead, so one image serves any environment and a flag
# flips with a `helm upgrade`. frontend/src/config.js resolves runtime first, build time second;
# both paths run the same code. See docs/kubernetes-architecture.md §2.1.
#
# VITE_ENABLE_REALTIME gates every supabase.channel() subscription. With it true the tabs update
# on Realtime change events and poll every 60s to reconcile; with it false they fall back to the
# original 3s poll.
# -----------------------------------------------------------------------------
VITE_ENABLE_REALTIME=true

# VITE_GITHUB_REPO_URL is the repository the "Report Bug" button files issues against. Point it
# at your own fork, or reports land on someone else's tracker. Repository root, no trailing
# slash and no /issues -- the modal appends /issues/new with a prefilled title and body.
VITE_GITHUB_REPO_URL=https://github.com/Harri-Llewelyn/ACS-Cymru

# VITE_GRAFANA_URL is where "View in Grafana" points from an active alert in the context drawer.
# THE SAME ORIGIN AS GRAFANA_PUBLIC_URL below, and it is a separate variable only because the
# browser resolves this one out of the bundle while GRAFANA_PUBLIC_URL is read by the database seed
# and by grafana.ini. Moving Grafana means setting both: leaving this one behind gives a dead
# hyperlink, leaving that one behind breaks the OAuth login, and the two failures look nothing alike.
# Port 3002, not Grafana's own 3000 -- the frontend already has 3000, so compose republishes it.
VITE_GRAFANA_URL=http://localhost:3002

# APP_VERSION is the build label the account menu shows (issue #57). LEAVE IT BLANK.
#
# Blank does not mean "unset and forgotten" here -- it is the correct everyday value, and the one
# thing that must NOT go in it is a version number. Compose reads this file on every build, so a
# literal like v0.1.0-156-gabc1234 keeps being baked in long after the commit it names, and the
# menu then states a build the bundle is not. "unknown" is the honest answer to a question nobody
# answered; a stale version is a wrong answer to it, and it is wrong in exactly the situation
# somebody is reading the figure -- chasing a fault and trying to say which build they saw it on.
#
# So this line exists to NAME the knob, not to hold a value. Label a build by supplying it for the
# one command instead, which is how it stays true:
#
#   PowerShell:  $env:APP_VERSION = (git describe --tags --always --dirty); docker compose up --build -d frontend
#   bash/zsh:    APP_VERSION=$(git describe --tags --always --dirty) docker compose up --build -d frontend
#
# A build run straight from a working tree needs none of this: with no value here and none in the
# environment, vite.config.js runs git describe itself. Only the container build cannot, because
# frontend/Dockerfile's context is ./frontend and there is no .git inside it.
#
# The published images set it from the release tag in .github/workflows/release.yml, so anything
# pulled from GHCR always names itself.
APP_VERSION=

# Whether GoTrue accepts self-registration at POST /auth/v1/signup. CLOSED BY DEFAULT.
#
# THIS REPLACES VITE_ALLOW_SIGNUP, which was a frontend flag and therefore never an access control.
# It hid the sign-up form; the endpoint behind it stayed open, so anyone who could reach Kong could
# self-register and be handed the default 'Operator' role by handle_new_user() -- past every RBAC
# decision in the database, none of which is consulted until you already hold a session.
#
# Leave this 'true' unless you specifically want open registration. Accounts arrive one of three
# ways instead: the four demo personas seeded by supabase/seed.sql, an admin invite through the
# Auth API, or an upstream identity provider.
#
# Setting it to 'false' reopens the endpoint for every caller, not just the dashboard -- the login
# screen no longer offers a form either way.
GOTRUE_DISABLE_SIGNUP=true

# -----------------------------------------------------------------------------
# Object storage (3D asset models)
#
# The asset-3d-models bucket is PUBLIC-READ, and that follows from what it is for: an AAS `File`
# element carries a URL that an arbitrary AAS viewer -- one holding no Factory+ session -- has to
# be able to dereference. Anything placed here is world-readable to whoever learns its path, so it
# must carry nothing more sensitive than the geometry of the machine. Writes are restricted to
# Administrator and Shopfloor_Manager by archived migration 0035's policies.
#
# AAS_MODEL_PUBLIC_BASE is the address embedded in exported shells. The default is only right for
# a local stack -- point it at the deployment's real gateway hostname, or every shell you hand out
# will reference localhost.
#
# "LOCALHOST" MEANS SOMETHING DIFFERENT TO EVERY CONSUMER, which is what makes this trap quiet:
# inside an Eclipse BaSyx container it is BaSyx, on a partner's laptop it is their laptop. The
# shell opens, validates, and its one File element resolves to nothing.
#
# THE EXPORTER NOW REFUSES ONE CASE OUTRIGHT. Producing an .aasx whose 3D model could NOT be
# bundled (over AAS_MAX_BUNDLED_MODEL_BYTES, or Storage unavailable) AND whose fallback URL is
# loopback returns a 500 naming this variable, because self-containment is the entire reason to
# produce a package rather than a JSON environment -- one that silently is not self-contained is
# worse than none. The JSON export only WARNS (`model_url_resolves_only_on_this_host` in `stats`),
# since there the URL is visible to the caller and a developer exporting locally is the case this
# default exists to serve.
#
# Set it to the address other machines use to reach this host, and check it resolves from inside
# whatever container will consume the shell:
#   AAS_MODEL_PUBLIC_BASE=http://10.20.0.50:54321/storage/v1/object/public/asset-3d-models
# -----------------------------------------------------------------------------
STORAGE_MODEL_BUCKET=asset-3d-models
STORAGE_FILE_SIZE_LIMIT=52428800
AAS_MODEL_PUBLIC_BASE=http://localhost:54321/storage/v1/object/public/asset-3d-models
# Cap on a model bundled into an .aasx. Above it the export falls back to a URL reference rather
# than holding the bytes in the edge worker's memory.
AAS_MAX_BUNDLED_MODEL_BYTES=33554432

# -----------------------------------------------------------------------------
# Standalone TimescaleDB Configuration (Telemetry Hypertable)
# -----------------------------------------------------------------------------
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# --- Telemetry lifecycle ------------------------------------------------------
# Applied on EVERY boot by the `timescaledb-retention` service, so changing either value here
# takes effect on the next `docker compose up` -- including on a stack that already holds data.
#
# Any PostgreSQL interval ('7 days', '12 hours', '5 years'); `never` turns the policy off.
#
# Compressed chunks are effectively read-only, so telemetry arriving with a timestamp older than
# this is rejected rather than inserted. Ingestion refuses anything over 24h old anyway, so this
# only bites if you lower it below a day.
#
# QUOTED, and it has to be. Docker Compose parses this file itself and would accept a bare
# `7 days`, but the documented way to run the E2E validator SOURCES it (`set -a && . ./.env`) --
# where an unquoted value containing a space is parsed as a command, printing `days: command not
# found` and, far worse, leaving `. ./.env` with a non-zero status so the rest of that `&&` chain
# never runs. The visible symptom is the validator failing to resolve `timescaledb`, which reads
# as a Docker networking fault several layers from an unquoted string.
TIMESCALE_COMPRESS_AFTER="7 days"
#
# RETENTION IS A HARD DELETE WITH NO UNDO -- TimescaleDB drops whole chunks and nothing here
# copies them anywhere first. 90 days is a starting point, NOT a compliance decision: it is your
# data and manufacturing traceability obligations run from weeks to decades. Set it deliberately
# before this stack carries production telemetry, or set `never` to keep everything and manage
# growth yourself.
TIMESCALE_RETAIN_FOR="90 days"
#
# --- Rollups -----------------------------------------------------------------
# 1-minute, 5-minute and 1-hour continuous aggregates, built 1m -> 5m -> 1h. Grafana's trend
# panels and any long-window query read these instead of scanning raw.
#
# THEY OUTLIVE THE RAW DATA ON PURPOSE. Each rollup is independent of the hypertable, so it
# survives the retention above: raw at 90 days but hourly buckets at 5 years keeps shape,
# excursions and state transitions long after the rows themselves are gone, at a tiny fraction of
# the size. A question about last spring is answerable from `telemetry_1h` or not at all.
#
# Same rules as above: any PostgreSQL interval, or `never` to keep a rollup indefinitely.
TIMESCALE_ROLLUP_1M_RETAIN_FOR="180 days"
TIMESCALE_ROLLUP_5M_RETAIN_FOR="1 year"
TIMESCALE_ROLLUP_1H_RETAIN_FOR="5 years"

# -----------------------------------------------------------------------------
# Read-only historian role for reporting tools (Grafana, Power BI)
# -----------------------------------------------------------------------------
# Created on the TimescaleDB instance by timescaledb/roles.sql, applied on every boot by
# timescaledb-maintenance. It may SELECT telemetry_1m / telemetry_5m / telemetry_1h and is
# explicitly revoked on raw `telemetry`, `assets` and `telemetry_latest`.
#
# EMPTY MEANS NO ROLE, not a role with a blank password -- roles.sql skips it entirely. That also
# means clearing this does NOT remove an already-created role; drop it by hand if that is the
# intent.
#
# Grafana connects as this account rather than as `postgres`. Changing the value rotates the
# password on the next `docker compose up` and needs a Grafana restart to pick it up.
BI_READER_PASSWORD=acscymru123

# -----------------------------------------------------------------------------
# Grafana Administration
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Grafana SSO (OAuth client of Supabase Auth's OIDC server)
# The secret is hashed into auth.oauth_clients by 0002_seed_data.sql and read by
# grafana.ini via $__env{GRAFANA_OAUTH_CLIENT_SECRET}. Rotating it means changing it here
# and restarting both supabase-db-init and grafana.
# -----------------------------------------------------------------------------
GRAFANA_OAUTH_CLIENT_SECRET=change-me-grafana-oauth-client-secret

# The address the BROWSER reaches Grafana on. No trailing slash.
#
# ONE VALUE FEEDS TWO PLACES that must agree exactly: 0002_seed_data.sql registers
# <this>/login/generic_oauth as the OAuth client's redirect_uris, and the grafana service builds
# GF_SERVER_ROOT_URL from it. A mismatch answers `invalid redirect_uri` at /oauth/authorize.
#
# This USED TO BE HARDCODED to http://localhost:3002 in the seed, and because that upsert is
# DO UPDATE, supabase-db-init rewrote it back on every boot -- so a hand-corrected row reverted at
# the next restart with nothing marking the change. Point it at the deployment's real hostname;
# the default is only right for a local stack. Changing it means restarting supabase-db-init and
# grafana, exactly as NODERED_PUBLIC_URL does.
GRAFANA_PUBLIC_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# MQTT Broker Configuration
# -----------------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883

# HOW SOMETHING OUTSIDE THE COMPOSE NETWORK REACHES THE BROKER, which is a different question from
# the two lines above: `mosquitto` resolves only inside the network, and a physical gateway on a
# plant LAN cannot use it. These are what the enrolment bundle stamps into an appliance's flow, so
# an empty MQTT_PUBLIC_HOST yields a bundle that cannot connect back.
#
# Left empty by default deliberately -- there is no value that is right for an arbitrary host, and
# guessing one produces a bundle that fails at the far end of an install rather than here.
#
# Added to this template after `scripts/check-env-drift.mjs` found all three set in a working .env
# and documented in neither: drift in the TEMPLATE, which is the direction nobody looks.
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_TLS_PORT=8883

# FOUR PRINCIPALS, NO SHARED ACCOUNT. There used to be one `factoryplus` credential holding
# `readwrite spBv1.0/#`, connected as by the ingestion daemon, the Node-RED simulator and the E2E
# validator alike -- so the credential that ran the demo flow could also forge DBIRTH and DDATA for
# every machine on the site. `verify_gateway_binding()` cannot catch that: a forged message under a
# correctly bound device passes it by construction. mosquitto.acl now confines each account, and
# nothing anywhere holds wildcard write.
#
# The simulator and validator usernames ARE `sparkplug_id`s, and cannot be anything else: the ACL
# pins the topic's edge-node segment to `%u`, and that segment must equal the gateway row's
# generated `sparkplug_id`. Both rows have PINNED UUIDs so the id -- and therefore the credential --
# is known before the row is created. Do not rename these.

# Subscribes to spBv1.0/# and publishes ONLY rebirth NCMDs.
MQTT_INGESTION_USER=factoryplus_ingestion
MQTT_INGESTION_PASSWORD=acscymru123

# The i3X server. Read-only, no write of any kind -- it refuses writes by design (405 on
# PUT /objects/value), and this is that stance expressed where the broker can enforce it.
MQTT_I3X_USER=factoryplus_i3x
MQTT_I3X_PASSWORD=acscymru123

# The RETIRED single-device simulator gateway, UUID 10000000-0000-4000-8000-000000000001.
#
# ITS GATEWAY ROW NO LONGER EXISTS -- migration 0020 deletes it, and the `Simulated Shopfloor` flow
# connects as four per-cell gateways instead (MQTT_GW_* below, issued by
# `npm run provision:gateways`). So a message published under this username is now refused by
# verify_gateway_binding() even though the broker accepts the connection.
#
# THE ACCOUNT IS KEPT ANYWAY, for one case: a Node-RED volume that predates the consolidation still
# holds the old flow with its `mqtt-broker-config` node, and node-red-init falls back to this pair
# for exactly that node. Removing the account would turn "an old flow publishes rows nothing reads"
# into "Node-RED cannot connect at all", which is the harder failure to diagnose. Reseed the flow
# (NODE_RED_FORCE_SEED=true) and this pair is dead configuration you can drop.
MQTT_SIMULATOR_USER=gwy100000000000400080000
# EMPTY BY DEFAULT, AND THAT IS THE SETTING. mosquitto-init skips an account whose password is
# empty -- the same rule the four MQTT_GW_* pairs already follow -- so a stock stack no longer
# carries a live broker credential for an edge node with no gateway row. Set a value only for
# the case above: a Node-RED volume that predates the consolidation.
MQTT_SIMULATOR_PASSWORD=

# ingestion/validate.py's gateway, UUID 11000000-0000-4000-8000-000000000001. Seeded by the
# validator itself, as a fixture -- a production stack can drop this account entirely.
MQTT_VALIDATOR_USER=gwy110000000000400080000
MQTT_VALIDATOR_PASSWORD=acscymru123

# $SYS only: the broker healthcheck and the Prometheus exporter sidecar. It can publish nothing.
MQTT_MONITOR_USER=factoryplus_monitor
MQTT_MONITOR_PASSWORD=acscymru123

# -----------------------------------------------------------------------------
# The four simulated cell gateways
# -----------------------------------------------------------------------------
# ONE ACCOUNT PER GATEWAY, BECAUSE THE BROKER SAYS SO. mosquitto.acl pins the topic's edge-node
# segment to the connecting username (`pattern readwrite spBv1.0/+/+/%u/#`), so the four cells of
# the `Simulated Shopfloor` flow cannot share a connection -- there is no shared principal to fall
# back on. Each broker node in node_red_flow.json names its pair here through `acsCredentialsEnv`.
#
# THE PASSWORDS ARE EMPTY ON A FRESH INSTALL, AND THAT IS A REVERSAL WORTH READING BEFORE YOU
# "FIX" IT. `npm run provision:gateways` is what fills them in.
#
# They used to be minted eagerly by `npm run setup`, for a reason that was real at the time:
# node-red-init FAILS CLOSED when a broker node declares a credential pair it cannot find, the
# simulator flow was seeded on every start, and that flow declares four broker nodes. So the
# alternative was a deadlock -- provisioning needs a RUNNING stack, and `docker compose up` exited 1
# on `service "node-red-init" didn't complete successfully`, naming neither the flow, the variable,
# nor the script that would have written it.
#
# Roadmap §14 dissolved that rather than working around it. The simulator flow is opt-in
# (NODE_RED_SEED_SIMULATOR), so a default stack seeds a starter flow with NO broker nodes -- no
# broker node, no credential requirement, no deadlock, and no accounts in the broker for four
# gateways that do not exist until somebody provisions them.
#
# mosquitto-init SKIPS AN EMPTY PASSWORD rather than creating a blank account, which is what makes
# leaving these unset safe. The fail-closed behaviour is unchanged and still applies the moment a
# flow declaring these pairs is seeded.
#
# THE USERNAMES ARE NOT SECRETS AND NOT GENERATED. Each is the `sparkplug_id` of a gateway
# `provision-gateways.mjs` creates at a pinned UUID -- 'gwy' plus the first 21 hex characters of it
# -- and the ACL matches it exactly. They are declared here so the pairing is legible; the gateway
# rows they name do not exist until provisioning runs.
#
# Note the direction of authority once they ARE set: mosquitto-init re-applies whatever is in this
# file on every start, so .env wins over a rotation that was never folded back in from
# .env.gateways.
MQTT_GW_CNC_MACHINING_USER=gwy120000000000400080000
MQTT_GW_CNC_MACHINING_PASSWORD=
MQTT_GW_ROBOTIC_ASSEMBLY_USER=gwy130000000000400080000
MQTT_GW_ROBOTIC_ASSEMBLY_PASSWORD=
# Named for the AGV fleet it used to serve. RENAMED IN PLACE to Cell 3 — Production KPIs: the row
# keeps its sparkplug_id, so this account, the ACL rule and every historical telemetry row keyed on
# that id stay valid. The key is frozen and no longer describes the gateway's name.
MQTT_GW_AGV_FLEET_USER=gwy140000000000400080000
MQTT_GW_AGV_FLEET_PASSWORD=
MQTT_GW_FACILITY_BMS_USER=gwy150000000000400080000
MQTT_GW_FACILITY_BMS_PASSWORD=

# -----------------------------------------------------------------------------
# MQTTS (8883) -- required for physical gateways
# -----------------------------------------------------------------------------
# THE COMPOSE BROKER NOW ISSUES ITS OWN CERTIFICATES. The `mosquitto-tls-init` service mints a
# 10-year internal root and an 825-day broker leaf into the `mosquitto_certs` volume on first boot,
# and `mosquitto-init` appends mosquitto-tls.conf once they exist. Nothing below has to be set for
# MQTTS to work on a local stack; these values exist to make the certificate name the address your
# gateways actually dial.
#
# 1883 STAYS OPEN. In-network clients (ingestion, i3X, the Node-RED simulator, every virtual
# gateway) keep using it -- their credentials never leave the container network. 8883 is for
# physical gateways, and their bundles are configured for it exclusively.
#
# THE ROOT IS DISTRIBUTED BY HAND and its volume must not be deleted casually:
#   docker compose exec mosquitto cat /mosquitto/certs/ca.crt
# `docker volume rm <project>_mosquitto_certs` mints a NEW root on the next boot, at which point
# every already-enrolled appliance rejects the broker. That is a fleet-wide re-enrolment, not a
# reset. See scripts/mosquitto-tls-init.mjs.

# Where a physical gateway APPLIANCE reaches the platform's API. Written into every bundle's .env
# and used by the appliance to redeem its enrolment token.
#
# THERE IS NO DEFAULT, and SUPABASE_URL is not one. That value is http://127.0.0.1:54321 on a local
# stack -- correct for a browser on this machine, and wrong for every appliance, because inside a
# container 127.0.0.1 is the container itself. `gateway-bundle` refuses to issue a token while this
# is unset or names an in-stack address, so the failure arrives before a bundle is handed out
# rather than at 3am on a shopfloor.
# SUPABASE_PUBLIC_URL=https://api.plant.example

# The address physical gateways use to reach the broker. FOLDED INTO THE CERTIFICATE'S SAN, so it
# must be set before the leaf is issued -- change it later and the service reissues the leaf on the
# next boot (the root is untouched, so no appliance has to be re-enrolled).
#
# It is also what the enrolment bundle tells an appliance to dial, so `mosquitto` and `localhost`
# are wrong here for anything off this host: those resolve on the Docker network and on this
# machine, and nowhere a gateway lives. Set your LAN hostname or IP.
# MQTT_PUBLIC_HOST=broker.plant.example
# MQTT_PUBLIC_TLS_PORT=8883

# Further SAN entries, comma separated. Bare values are classified automatically (an IPv4 address
# becomes IP:, anything else DNS:); an explicit "DNS:x" or "IP:x" is passed through. Use this when
# the broker is reachable by more than one name -- a short hostname and an FQDN, say.
# MQTT_TLS_SAN_EXTRA=broker,10.20.0.5

# -----------------------------------------------------------------------------
# Broker credential-issuing service
# -----------------------------------------------------------------------------
# The bearer token supabase-functions presents to the `gateway-credential` service, which is the
# only thing that may add an account to the Mosquitto password file. Generated by
# `npm run setup`; the service REFUSES TO START if it is unset or shorter than 32 characters.
#
# ITS OWN VALUE, never shared with another secret. This service can mint a credential for any edge
# node, and mosquitto.acl turns an account into the ability to publish Sparkplug telemetry as that
# gateway -- so a token reused elsewhere means one leak grants forgery across the site.
#
# THE SERVICE IS NOT PUBLISHED. It has no `ports:` on Compose and a NetworkPolicy on Kubernetes
# admitting only the edge functions; the token is the second layer of that, not the first.
MQTT_CREDENTIAL_SERVICE_TOKEN=

# Where enroll-gateway reaches it. Compose-internal by construction -- if this ever needs to be a
# routable address, the service has been exposed and the paragraph above no longer holds.
# MQTT_CREDENTIAL_SERVICE_URL=http://gateway-credential:9010

# -----------------------------------------------------------------------------
# Gateway flow backups
# -----------------------------------------------------------------------------
# A PRIVATE bucket holding Node-RED `flows.json` exports from gateway appliances, stored under
# <sparkplug_id>/. Created by scripts/storage-init.mjs; its RLS lives in
# supabase/storage-policies.sql, which grants read to Administrator, Shopfloor_Manager and Auditor
# and write to the first two only.
#
# ONLY flows.json IS EVER STORED HERE -- never flows_cred.json, and never NODERED_CREDENTIAL_SECRET.
# A restored appliance re-injects its credentials from the environment its enrolment wrote, so a
# backup describes behaviour and never secrets.
#
# CHANGING THE NAME MEANS CHANGING supabase/storage-policies.sql TOO. A bucket with no policies is
# invisible to every browser-facing role; a policy naming a bucket that does not exist is dead text.
# Neither errors.
# GATEWAY_BACKUP_BUCKET=gateway-backups
# GATEWAY_BACKUP_FILE_SIZE_LIMIT=5242880

# --- Broker captures ---------------------------------------------------------------------------
#
# Recorded Sparkplug traffic, written by `python ingestion/capture.py record` and played back by
# `capture.py play`. Stored under <sparkplug_id>/ of the gateway a capture plays back AS, which is
# never the one it was recorded from: mosquitto.acl pins the topic's edge-node segment to the
# connecting username, so playback always rewrites identities onto one gateway's own assets.
#
# PRIVATE, AND MORE SENSITIVE THAN A FLOW BACKUP RATHER THAN LESS. A flows.json describes what the
# edge is configured to do; a capture is a recording of what it actually said -- every device id
# that spoke, every metric name, and the values.
#
# The limit is sized from the traffic: the fleet's measured rate is 0.95 msg/s at a few hundred
# bytes a message, so a full working day fits in 25 MiB. What it refuses is a capture taken at the
# ingestion ceiling, which is a load-test artefact rather than something anyone keeps.
#
# CHANGING THE NAME MEANS CHANGING supabase/storage-policies.sql TOO, for the same reason as above.
# CAPTURE_BUCKET=broker-captures
# CAPTURE_FILE_SIZE_LIMIT=26214400

# --- CLIENT-side TLS, for the ingestion daemon, the i3X server and Node-RED -----------------
#
# SEPARATE FROM THE LISTENER ABOVE, and the distinction is load-bearing: these say "this CLIENT
# connects over TLS", not "the broker offers it". All three run on the container network, where
# 1883 is already private, so they are left off by default -- turning them on is a hardening choice
# and not a prerequisite for physical gateways.
#
# NODE-RED IS THE ONE THAT USED TO BE MISSING, and its absence was silent: the simulated gateways
# went on publishing in clear on 1883 while the other two moved to 8883, because nothing was
# configured wrongly -- the switch simply never reached them. It does now.
#
# SET MQTT_PORT TOO. Compose has no conditional in ${}, so the port is a separate variable here
# where the chart derives it from the same flag. node-red-init refuses to start on TLS-with-1883
# rather than let it present as a broker that will not connect.
#
# MQTT_TLS_CA_FILE IS NOT OPTIONAL WHEN TLS IS ON. An internal CA is not in any system trust store,
# so an empty value means verification fails outright. There is deliberately no "skip verification"
# setting anywhere in this stack: TLS that does not verify is indistinguishable, from the client's
# side, from a successful interception. Both clients refuse to start rather than downgrade.
#
# The CA is mounted into all three containers already, read-only, from the same volume
# mosquitto-tls-init writes -- so these three lines are the whole change. `ca.crt` is world-readable
# and `ca.key` is root-owned at 0600, so what they can read is the root of trust and not the key
# that signs with it.
#
# On Kubernetes these are set for you -- see mosquitto.tls.* in the chart's values.yaml.
# MQTT_TLS_ENABLED=true
# MQTT_TLS_CA_FILE=/etc/acs-cymru/broker-ca/ca.crt
# MQTT_PORT=8883

# -----------------------------------------------------------------------------
# Ingestion: device liveness and Sparkplug rebirth
#
# DEVICE_OFFLINE_TIMEOUT_SECONDS -- a device that stops publishing writes nothing and emits no
# DDEATH, so without a watchdog it stays ONLINE forever. Set 0 to disable. Raise it for a fleet of
# event-driven devices that legitimately stay quiet longer than this; the failure of too LOW a
# value is a healthy machine reported offline, which is the more misleading of the two.
#
# REBIRTH_REQUEST_INTERVAL_SECONDS -- Sparkplug metric aliases are bound to names in a birth
# certificate and the table is held in memory, so it is empty after every ingestion restart. The
# daemon recovers by asking the edge node to re-birth (NCMD `Node Control/Rebirth`). This limits
# how often it may ask ONE node: a gateway that answers a rebirth by restarting would otherwise be
# held in a reboot loop by the mechanism meant to recover it.
#
# The defaults below are also the chart's (ingestion.* in values.yaml) and the ones validate.py
# assumes. Change them in both places or its watchdog check will assert against the wrong window.
DEVICE_OFFLINE_TIMEOUT_SECONDS=300
DEVICE_WATCHDOG_INTERVAL_SECONDS=30
REBIRTH_REQUEST_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Node-RED Edge Runtime
# -----------------------------------------------------------------------------
NODERED_CREDENTIAL_SECRET=acscymrusecret

# -----------------------------------------------------------------------------
# Node-RED authentication (Supabase Auth SSO + machine-to-machine)
#
# Until these existed, Node-RED's editor and its /flows admin API were OPEN to anyone who could
# reach port 1880 -- edge automation flows could be read or replaced, and the quarantine webhook
# receiver accepted anything. EVERY VALUE BELOW IS REQUIRED: scripts/node-red-init.mjs refuses
# to write a settings.js without them rather than degrading back to an unauthenticated Node-RED,
# so a missing one stops the stack with one legible message instead of quietly reopening it.
#
# HUMANS sign in through Supabase Auth (OAuth2 + PKCE), exactly as Grafana does -- and, as with
# Grafana, the `openid` scope is deliberately NOT requested: GoTrue refuses to sign an ID token
# under HS256. Identity and role come from the nodered-userinfo edge function instead, which
# reads public.user_roles. Administrator and Shopfloor_Manager can deploy; Operator and Auditor
# get a read-only editor; an unmapped role is refused outright.
#
# Note the same prerequisite Grafana SSO has: the user must ALREADY BE SIGNED IN to the Factory+
# dashboard, because GoTrue ships no consent UI and the React app serves it at /oauth/consent.
# -----------------------------------------------------------------------------
NODERED_OAUTH_CLIENT_ID=c0ffee00-0000-4000-8000-000000000002
# Hashed into auth.oauth_clients by migration 0003 and read by settings.js from Node-RED's own
# environment. Rotating it means changing it here and restarting supabase-db-init, node-red-init
# and node-red.
NODERED_OAUTH_CLIENT_SECRET=change-me-nodered-oauth-client-secret

# The address the BROWSER reaches Node-RED on. Migration 0003 registers <this>/auth/strategy/
# callback as the client's redirect_uris and settings.js hands passport-oauth2 the same string,
# so the two are built from this one value -- they must match exactly or /oauth/authorize
# answers "invalid redirect_uri". Point it at the deployment's real hostname; the default is
# only right for a local stack.
NODERED_PUBLIC_URL=http://localhost:1880

# -----------------------------------------------------------------------------
# Node-RED machine-to-machine
#
# deploy-nodered needs no secret at all: it forwards the access token of the operator who
# triggered the deploy, and Node-RED re-derives their role from public.user_roles.
#
# The quarantine webhook is the other direction (Supabase -> Node-RED), where there is no user.
# NODERED_WEBHOOK_JWT_SECRET is the HS256 key dispatch_device_quarantine_webhook() SIGNS a fresh
# 60-second token with per event, and that Node-RED verifies. It is NOT a bearer credential and
# deliberately NOT the admin token: /hooks/quarantine is served by an `http in` node, so any
# flow author can read msg.req.headers -- sharing the admin credential with the webhook would
# hand every flow in the instance full admin API access.
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
NODERED_WEBHOOK_JWT_SECRET=change-me-nodered-webhook-signing-key-min-32-chars

# -----------------------------------------------------------------------------
# Grafana alerting -> Supabase
#
# The bearer secret Grafana presents to the grafana-alert-webhook edge function, which verifies it
# and then writes to public.device_alerts with its own service-role client.
#
# THIS EXISTS SO GRAFANA IS NOT GIVEN THE SERVICE-ROLE KEY. That key bypasses RLS entirely and can
# rewrite digital_thread, and this stack already removed the equivalent once -- Grafana used to reach
# the historian as the `postgres` superuser. A service fronted by browser SSO gets the narrowest
# credential that does its job, which here is "record an alert" and nothing else.
#
# Its own value, shared with nothing: a secret reused elsewhere means one leak reopens the authority
# this one was created to withhold.
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
GRAFANA_ALERT_WEBHOOK_SECRET=change-me-grafana-alert-webhook-bearer-min-32-chars

# BREAK-GLASS ONLY -- leave empty. A static token accepted on the admin API that bypasses
# Supabase entirely, for when Supabase Auth, Kong or the edge runtime is down and the flows
# still have to be reachable. Seeded into Vault by 0002_seed_data.sql. Same reasoning as
# disable_login_form = false in grafana/grafana.ini: SSO being down is exactly when you need
# the thing SSO protects.
NODERED_ADMIN_TOKEN=

# Shared secret the revoke-gateway-credential edge function verifies (migration 0038). A trigger on
# gateways presents it through Kong when a gateway is archived or deleted, and the function then
# rotates that gateway's broker account to a password nobody records. Unset means revocation is
# INERT -- archiving will not revoke. Generate with: openssl rand -base64 32
GATEWAY_REVOKE_SECRET=
