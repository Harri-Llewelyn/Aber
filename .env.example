# -----------------------------------------------------------------------------
# Database Configuration (TimescaleDB)
# -----------------------------------------------------------------------------
# Host name for container-to-container connections
DB_HOST=timescaledb
# Internal port 5432 (exposed as 5433 on host)
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

