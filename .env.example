# =============================================================================
# Factory+ Asset Tracking Environment Configuration Example
# Copy this file to .env and adjust values for your local or production setup.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Self-Hosted Backend-as-a-Service (BaaS) Configuration
# Consumed by docker-compose.yml (supabase-db, supabase-auth, supabase-rest,
# supabase-kong, supabase-studio), frontend build, and Python ingestion.
# POSTGRES_PASSWORD configures the database password for the postgres superuser
# and least-privilege scoped database roles (supabase_auth_admin for GoTrue, authenticator for PostgREST).
POSTGRES_PASSWORD=postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiZXhwIjoyMDAwMDAwMDAwfQ.Z7KTfqo7mvr4j40uB-6K4f_VVT-d-ISkJ7E5VJ41jt0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJleHAiOjIwMDAwMDAwMDB9.GWSHLKn253lfP0FAYobjuXvQkQGcYhKVJ6Y0IJOo-lA
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
# Used by postgres-meta to encrypt stored connection strings, and by Supabase Studio
# to talk to it. Both services must be given the same value.
PG_META_CRYPTO_KEY=factoryplus-pg-meta-crypto-key
KONG_HTTP_PORT=54321
SUPABASE_DB_PORT=54322
STUDIO_PORT=54323

# Swagger UI interactive API reference (docs/openapi.yaml + live PostgREST schema).
# Changing this port also requires updating the CORS origins in supabase/kong.yml.
SWAGGER_PORT=8088

# -----------------------------------------------------------------------------
# Supabase Realtime (WebSocket change feed, consumed by supabase-realtime)
# REALTIME_DB_ENC_KEY must be EXACTLY 16 characters and REALTIME_SECRET_KEY_BASE
# at least 64 -- the container refuses to boot otherwise.
# These are local-dev demo values, as with the JWT keys above. Generate real ones:
#   openssl rand -hex 8     -> 16 chars
#   openssl rand -hex 32    -> 64 chars
# -----------------------------------------------------------------------------
REALTIME_DB_ENC_KEY=supabaserealtime
REALTIME_SECRET_KEY_BASE=8f2c1d4b7a9e0356c8b1f4d72e5a90c3b6d8f1a4e7c025d9a3e6b8c1f4d7a0e39

# -----------------------------------------------------------------------------
# Frontend feature flags (baked into the bundle at build time by frontend/Dockerfile)
# VITE_ENABLE_REALTIME gates every supabase.channel() subscription. With it true the tabs
# update on Realtime change events and poll every 60s to reconcile; with it false they fall
# back to the original 3s poll. Changing it requires rebuilding the frontend image.
# -----------------------------------------------------------------------------
VITE_ENABLE_REALTIME=true

# VITE_GITHUB_REPO_URL is the repository the "Report Bug" button files issues against. Point it
# at your own fork, or reports land on someone else's tracker. Repository root, no trailing
# slash and no /issues -- the modal appends /issues/new with a prefilled title and body.
# Also build-time: changing it requires rebuilding the frontend image.
VITE_GITHUB_REPO_URL=https://github.com/Harri-Llewelyn/ACS-Cymru

# -----------------------------------------------------------------------------
# Object storage (3D asset models)
#
# The asset-3d-models bucket is PUBLIC-READ, and that follows from what it is for: an AAS `File`
# element carries a URL that an arbitrary AAS viewer -- one holding no Factory+ session -- has to
# be able to dereference. Anything placed here is world-readable to whoever learns its path, so it
# must carry nothing more sensitive than the geometry of the machine. Writes are restricted to
# Administrator and Shopfloor_Manager by migration 0035's policies.
#
# AAS_MODEL_PUBLIC_BASE is the address embedded in exported shells. The default is only right for
# a local stack -- point it at the deployment's real gateway hostname, or every shell you hand out
# will reference localhost.
# -----------------------------------------------------------------------------
STORAGE_MODEL_BUCKET=asset-3d-models
STORAGE_FILE_SIZE_LIMIT=52428800
AAS_MODEL_PUBLIC_BASE=http://localhost:54321/storage/v1/object/public/asset-3d-models
# Cap on a model bundled into an .aasx. Above it the export falls back to a URL reference rather
# than holding the bytes in the edge worker's memory.
AAS_MAX_BUNDLED_MODEL_BYTES=33554432

# -----------------------------------------------------------------------------
# Standalone TimescaleDB Configuration (Telemetry Hypertable)
# -----------------------------------------------------------------------------
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Grafana Administration
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Grafana SSO (OAuth client of Supabase Auth's OIDC server)
# The secret is hashed into auth.oauth_clients by migration 20260101000028 and read by
# grafana.ini via $__env{GRAFANA_OAUTH_CLIENT_SECRET}. Rotating it means changing it here
# and restarting both supabase-db-init and grafana.
# -----------------------------------------------------------------------------
GRAFANA_OAUTH_CLIENT_SECRET=change-me-grafana-oauth-client-secret

# -----------------------------------------------------------------------------
# MQTT Broker Configuration
# -----------------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=factoryplus
MQTT_PASSWORD=factoryplus123

# -----------------------------------------------------------------------------
# Node-RED Edge Runtime
# -----------------------------------------------------------------------------
NODERED_CREDENTIAL_SECRET=factoryplussecret

# -----------------------------------------------------------------------------
# Node-RED authentication (Supabase Auth SSO + machine-to-machine)
#
# Until these existed, Node-RED's editor and its /flows admin API were OPEN to anyone who could
# reach port 1880 -- edge automation flows could be read or replaced, and the quarantine webhook
# receiver accepted anything. EVERY VALUE BELOW IS REQUIRED: scripts/node-red-init.mjs refuses
# to write a settings.js without them rather than degrading back to an unauthenticated Node-RED,
# so a missing one stops the stack with one legible message instead of quietly reopening it.
#
# HUMANS sign in through Supabase Auth (OAuth2 + PKCE), exactly as Grafana does -- and, as with
# Grafana, the `openid` scope is deliberately NOT requested: GoTrue refuses to sign an ID token
# under HS256. Identity and role come from the nodered-userinfo edge function instead, which
# reads public.user_roles. Administrator and Shopfloor_Manager can deploy; Operator and Auditor
# get a read-only editor; an unmapped role is refused outright.
#
# Note the same prerequisite Grafana SSO has: the user must ALREADY BE SIGNED IN to the Factory+
# dashboard, because GoTrue ships no consent UI and the React app serves it at /oauth/consent.
# -----------------------------------------------------------------------------
NODERED_OAUTH_CLIENT_ID=c0ffee00-0000-4000-8000-000000000002
# Hashed into auth.oauth_clients by migration 0003 and read by settings.js from Node-RED's own
# environment. Rotating it means changing it here and restarting supabase-db-init, node-red-init
# and node-red.
NODERED_OAUTH_CLIENT_SECRET=change-me-nodered-oauth-client-secret

# The address the BROWSER reaches Node-RED on. Migration 0003 registers <this>/auth/strategy/
# callback as the client's redirect_uris and settings.js hands passport-oauth2 the same string,
# so the two are built from this one value -- they must match exactly or /oauth/authorize
# answers "invalid redirect_uri". Point it at the deployment's real hostname; the default is
# only right for a local stack.
NODERED_PUBLIC_URL=http://localhost:1880

# -----------------------------------------------------------------------------
# Node-RED machine-to-machine
#
# deploy-nodered needs no secret at all: it forwards the access token of the operator who
# triggered the deploy, and Node-RED re-derives their role from public.user_roles.
#
# The quarantine webhook is the other direction (Supabase -> Node-RED), where there is no user.
# NODERED_WEBHOOK_JWT_SECRET is the HS256 key dispatch_device_quarantine_webhook() SIGNS a fresh
# 60-second token with per event, and that Node-RED verifies. It is NOT a bearer credential and
# deliberately NOT the admin token: /hooks/quarantine is served by an `http in` node, so any
# flow author can read msg.req.headers -- sharing the admin credential with the webhook would
# hand every flow in the instance full admin API access.
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
NODERED_WEBHOOK_JWT_SECRET=change-me-nodered-webhook-signing-key-min-32-chars

# BREAK-GLASS ONLY -- leave empty. A static token accepted on the admin API that bypasses
# Supabase entirely, for when Supabase Auth, Kong or the edge runtime is down and the flows
# still have to be reachable. Seeded into Vault by 0002_seed_data.sql. Same reasoning as
# disable_login_form = false in grafana/grafana.ini: SSO being down is exactly when you need
# the thing SSO protects.
NODERED_ADMIN_TOKEN=
