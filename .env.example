# =============================================================================
# Factory+ Asset Tracking Environment Configuration Example
# Copy this file to .env and adjust values for your local or production setup.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Self-Hosted Backend-as-a-Service (BaaS) Configuration
# Consumed by docker-compose.yml (supabase-db, supabase-auth, supabase-rest,
# supabase-kong, supabase-studio), frontend build, and Python ingestion.
# POSTGRES_PASSWORD configures the database password for the postgres superuser
# and least-privilege scoped database roles (supabase_auth_admin for GoTrue, authenticator for PostgREST).
POSTGRES_PASSWORD=postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiZXhwIjoyMDAwMDAwMDAwfQ.Z7KTfqo7mvr4j40uB-6K4f_VVT-d-ISkJ7E5VJ41jt0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJleHAiOjIwMDAwMDAwMDB9.GWSHLKn253lfP0FAYobjuXvQkQGcYhKVJ6Y0IJOo-lA
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
# Used by postgres-meta to encrypt stored connection strings, and by Supabase Studio
# to talk to it. Both services must be given the same value.
PG_META_CRYPTO_KEY=factoryplus-pg-meta-crypto-key
KONG_HTTP_PORT=54321
SUPABASE_DB_PORT=54322
STUDIO_PORT=54323

# Swagger UI interactive API reference (docs/openapi.yaml + live PostgREST schema).
# Changing this port also requires updating the CORS origins in supabase/kong.yml.
SWAGGER_PORT=8088

# -----------------------------------------------------------------------------
# Supabase Realtime (WebSocket change feed, consumed by supabase-realtime)
# REALTIME_DB_ENC_KEY must be EXACTLY 16 characters and REALTIME_SECRET_KEY_BASE
# at least 64 -- the container refuses to boot otherwise.
# These are local-dev demo values, as with the JWT keys above. Generate real ones:
#   openssl rand -hex 8     -> 16 chars
#   openssl rand -hex 32    -> 64 chars
# -----------------------------------------------------------------------------
REALTIME_DB_ENC_KEY=supabaserealtime
REALTIME_SECRET_KEY_BASE=8f2c1d4b7a9e0356c8b1f4d72e5a90c3b6d8f1a4e7c025d9a3e6b8c1f4d7a0e39

# -----------------------------------------------------------------------------
# Frontend feature flags (baked into the bundle at build time by frontend/Dockerfile)
# VITE_ENABLE_REALTIME gates every supabase.channel() subscription. With it true the tabs
# update on Realtime change events and poll every 60s to reconcile; with it false they fall
# back to the original 3s poll. Changing it requires rebuilding the frontend image.
# -----------------------------------------------------------------------------
VITE_ENABLE_REALTIME=true

# -----------------------------------------------------------------------------
# Standalone TimescaleDB Configuration (Telemetry Hypertable)
# -----------------------------------------------------------------------------
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Grafana Administration
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Grafana SSO (OAuth client of Supabase Auth's OIDC server)
# The secret is hashed into auth.oauth_clients by migration 20260101000028 and read by
# grafana.ini via $__env{GRAFANA_OAUTH_CLIENT_SECRET}. Rotating it means changing it here
# and restarting both supabase-db-init and grafana.
# -----------------------------------------------------------------------------
GRAFANA_OAUTH_CLIENT_SECRET=change-me-grafana-oauth-client-secret

# -----------------------------------------------------------------------------
# MQTT Broker Configuration
# -----------------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=factoryplus
MQTT_PASSWORD=factoryplus123

# -----------------------------------------------------------------------------
# Node-RED Edge Runtime
# -----------------------------------------------------------------------------
NODERED_CREDENTIAL_SECRET=factoryplussecret
