    {
      "id": 11,
      "type": "timeseries",
      "title": "Free disk",
      "description": "The trend the database cannot give: `gateways.disk_free_bytes` holds only the latest value, so it answers 'how full' but never 'is it filling'. This reads the daemon's Prometheus gauge instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aber_ingestion_gateway_disk_free_bytes{edge_node=\"$gateway\"}",
          "legendFormat": "{{edge_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1073741824
              },
              {
                "color": "green",
                "value": 5368709120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Available memory",
      "description": "Host MemAvailable. Available, not free: it counts reclaimable cache, which is the number that predicts whether an allocation will succeed.",
