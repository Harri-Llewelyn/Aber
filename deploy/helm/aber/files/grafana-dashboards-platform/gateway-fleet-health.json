      "type": "stat",
      "title": "Bundle",
      "description": "`agent_version`, refreshed from the heartbeat since migration 0035 rather than stamped once at enrolment -- so an appliance upgraded in place shows its new version without re-enrolling.",
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "gridPos": {
        "h": 4,
