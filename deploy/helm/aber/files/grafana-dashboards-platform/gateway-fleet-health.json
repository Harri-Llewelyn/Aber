{
  "uid": "aber-gateway-health",
  "title": "Gateway Fleet Health",
  "description": "Every gateway's condition, and one appliance in detail; pick it with the variable above. Tiles and table read `gateway_health` in Supabase, which holds no history; trends read the ingestion daemon's Prometheus gauges (ingestion/metrics.py explains why).",
  "tags": [
    "aber",
    "platform",
    "gateways"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "gateway",
        "label": "Gateway",
        "description": "Every non-archived gateway, refreshed on dashboard load. The list SHOWS the gateway's name and PASSES its sparkplug_id, which is the immutable wire identity -- so a rename does not break a saved link, and the same value selects the Prometheus series, whose `edge_node` label is that id.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "supabase"
        },
        "definition": "SELECT gateway_name AS __text, sparkplug_id AS __value FROM gateway_health ORDER BY gateway_name",
        "query": "SELECT gateway_name AS __text, sparkplug_id AS __value FROM gateway_health ORDER BY gateway_name",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Every gateway, worst first",
      "description": "One row per non-archived gateway, stale and nearest CA expiry first. Blank health columns are normal: host-run gateways and pre-0035 bundles report none. A large health age means the collector stopped while the gateway kept beating.",
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT gateway_name AS \"Gateway\",\n       live_status AS \"Status\",\n       heartbeat_age_seconds AS \"Heartbeat age\",\n       health_age_seconds AS \"Health age\",\n       disk_free_bytes AS \"Disk free\",\n       mem_available_bytes AS \"Memory available\",\n       load_1m AS \"Load 1m\",\n       cert_expires_in_days AS \"CA expires in\",\n       agent_version AS \"Bundle\",\n       left(flow_hash, 12) AS \"Flow\"\n  FROM gateway_health\n ORDER BY is_stale DESC, cert_expires_in_days NULLS LAST, gateway_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Heartbeat age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 90
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 300
                    },
                    {
                      "color": "red",
                      "value": 900
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk free"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1073741824
                    },
                    {
                      "color": "green",
                      "value": 5368709120
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory available"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CA expires in"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "green",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "$gateway — current state",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Status",
      "description": "`live_status` from `gateway_status`, which derives STALE at read time from a 90-second threshold. Enrolment states win outright: a gateway mid-installation is not a fault.",
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT live_status AS value FROM gateway_health WHERE sparkplug_id = '$gateway'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ONLINE": {
                  "color": "green",
                  "index": 0
                },
                "STALE": {
                  "color": "orange",
                  "index": 1
                },
                "OFFLINE": {
                  "color": "red",
                  "index": 2
                },
                "AWAITING_BIRTH": {
                  "color": "blue",
                  "index": 3
                },
                "PENDING_ENROLLMENT": {
                  "color": "blue",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Heartbeat age",
      "description": "Seconds since the last node-level Sparkplug message. Amber at 90s, which is the threshold `gateway_status` calls STALE; the appliance beats every 30s, so that is three missed beats.",
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT heartbeat_age_seconds AS value FROM gateway_health WHERE sparkplug_id = '$gateway'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto"
      }
    },
    {
