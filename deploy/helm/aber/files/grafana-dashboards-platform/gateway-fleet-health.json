      "type": "stat",
      "title": "Health last reported",
      "description": "Seconds since a heartbeat last carried a health metric. Empty means this gateway never reports health (older bundle, or host-run). Large means the collector stopped while the gateway kept beating.",
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT health_age_seconds AS value FROM gateway_health WHERE sparkplug_id = '$gateway'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "not reported",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
