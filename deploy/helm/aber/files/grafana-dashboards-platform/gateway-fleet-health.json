    {
      "id": 7,
      "type": "stat",
      "title": "CA expires in",
      "description": "Days until the broker CA this appliance holds expires. A re-minted CA fails silently: the whole fleet drops off at once, so this panel and its alert rule are the month's warning. Negative means already expired.",
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT cert_expires_in_days AS value FROM gateway_health WHERE sparkplug_id = '$gateway'"
        }
