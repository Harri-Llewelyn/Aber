      "id": 9,
      "type": "stat",
      "title": "Runtime uptime",
      "description": "Seconds since the appliance's Node-RED runtime started: process uptime, not host uptime. A value that keeps resetting while the host stays up is worth investigating.",
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
