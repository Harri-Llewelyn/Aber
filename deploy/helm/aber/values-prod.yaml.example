# =============================================================================================
# Production starting point. COPY, do not edit in place, and do not commit the copy.
#
#   cp values-prod.yaml.example values-prod.yaml   # then fill in, and keep it out of git
#
# Nothing here is filled in on purpose. The chart refuses to render with missing credentials
# rather than generating them -- see the note on `secrets` in values.yaml for why the four
# Supabase values are a matching SET and cannot be generated independently.
# =============================================================================================

global:
  # Every ingress hostname is derived from this: app.<domain>, api.<domain>, grafana.<domain>,
  # nodered.<domain>, studio.<domain>, docs.<domain>, mqtt.<domain>. A wildcard DNS record and a
  # wildcard certificate for *.<domain> are the simplest way to serve them.
  publicBaseDomain: aber.example.com
  scheme: https

  # local-path is k3s's default and is NODE-LOCAL: the PVC binds to one node and there is no
  # replication. On a single-node on-prem cluster that is the intended arrangement, but it makes
  # backups the only recovery path -- see plan §10. On a multi-node cluster, use a storage class
  # with real redundancy, or pin the data tier to one node deliberately.
  storageClass: local-path

  imagePullSecrets: []
  #  - name: registry-credentials

secrets:
  # ============================================================================================
  # PRODUCTION: SET THIS AND LEAVE EVERYTHING BELOW EMPTY.
  #
  # Point it at a Secret managed outside the chart. Every value below is then ignored, the chart
  # renders no Secret of its own, and the credential validation is skipped -- because the values
  # are no longer the chart's to see. No template change is needed; this is the seam.
  #
  # THE SECRET MUST CARRY THESE KEYS. They are the ENVIRONMENT VARIABLE names, not the camelCase
  # values-file names, precisely so an externally-managed Secret has one obvious contract:
  #
  #   SUPABASE_JWT_SECRET          SUPABASE_ANON_KEY          SUPABASE_SERVICE_ROLE_KEY
  #   SUPABASE_PUBLISHABLE_KEY     SUPABASE_SECRET_KEY
  #   POSTGRES_PASSWORD            DB_PASSWORD                PG_META_CRYPTO_KEY
  #   REALTIME_DB_ENC_KEY          REALTIME_SECRET_KEY_BASE
  #   MQTT_USER                    MQTT_PASSWORD
  #   GRAFANA_ADMIN_USER           GRAFANA_ADMIN_PASSWORD     GRAFANA_OAUTH_CLIENT_SECRET
  #   NODERED_CREDENTIAL_SECRET    NODERED_OAUTH_CLIENT_SECRET
  #   NODERED_WEBHOOK_JWT_SECRET   NODERED_ADMIN_TOKEN
  #
  # STILL A SET. SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are HS256 JWTs signed by
  # SUPABASE_JWT_SECRET, and SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY are the keys callers
  # present, which the gateway translates to those JWTs. Rotating the signing key in your secret
  # store WITHOUT re-minting both tokens gives a stack that reports healthy and rejects every
  # request at the gateway -- and the chart cannot warn you, because it cannot see them. Rotate
  # them together, always.
  #
  # NODERED_ADMIN_TOKEN must be present but EMPTY. It is a break-glass static token that bypasses
  # Supabase Auth entirely; an absent key and an empty one are the same to the chart, but some
  # secret stores refuse to store an empty value -- if yours does, that is the one to omit.
  #
  # --- External Secrets Operator ---------------------------------------------------------------
  # Create the ExternalSecret alongside this release (not from this chart -- a chart that owned it
  # would need to own the SecretStore too, and those are cluster infrastructure):
  #
  #   apiVersion: external-secrets.io/v1beta1
  #   kind: ExternalSecret
  #   metadata:
  #     name: aber-secrets
  #     namespace: aber
  #   spec:
  #     refreshInterval: 1h
  #     secretStoreRef: { name: <your-store>, kind: ClusterSecretStore }
  #     target:
  #       name: aber-secrets     # <- the name to put in existingSecret below
  #       creationPolicy: Owner
  #     dataFrom:
  #       - extract: { key: aber/prod }   # one vault entry, keys as above
  #
  # ROTATION IS NOT AUTOMATIC EVEN WITH ESO. Most of these are read into a pod's environment at
  # START, so a refreshed Secret reaches nothing until the pod restarts. Two need more than that:
  #   * The gateway's API keys are substituted into its config by an initContainer, so rotating
  #     them needs `kubectl rollout restart deployment/supabase-envoy`.
  #   * The Grafana and Node-RED OAuth client secrets are HASHED INTO auth.oauth_clients by the
  #     db-init hook, so rotating either needs a `helm upgrade` to re-run it -- and both halves must
  #     move together or the OAuth handshake fails with `invalid_credentials`.
  # Consider Reloader (stakater/Reloader) to automate the restarts.
  #
  # --- SOPS -------------------------------------------------------------------------------------
  # If there is no vault, keep an encrypted values file instead and decrypt at deploy time:
  #
  #   sops -e values-prod.yaml > values-prod.enc.yaml     # commit the .enc, never the plaintext
  #   helm secrets upgrade aber . -f values-prod.enc.yaml   # helm-secrets plugin
  #
  # That path uses the values below rather than existingSecret, so the chart renders the Secret --
  # which means the credentials appear in `helm get manifest` and in the release's stored revision.
  # Acceptable for a small on-prem deployment; ESO is better where it is available.
  # ============================================================================================
  existingSecret: ""

  # ---- Only needed when existingSecret is empty -------------------------------------------
  #
  # THESE ARE A SET. anonKey and serviceRoleKey are HS256 JWTs signed by jwtSecret with
  # {"iss":"supabase","role":"anon"} and {"iss":"supabase","role":"service_role"}; publishableKey
  # and secretKey are the `sb_publishable_*` / `sb_secret_*` keys callers present, which the
  # gateway translates to those JWTs. Changing jwtSecret alone invalidates both JWTs and every
  # request fails at the gateway while the stack reports healthy.
  jwtSecret: ""
  anonKey: ""
  serviceRoleKey: ""
  publishableKey: ""
  secretKey: ""

  postgresPassword: ""
  timescalePassword: ""

  # openssl rand -hex 8    -> exactly 16 characters (enforced)
  realtimeDbEncKey: ""
  # openssl rand -hex 32   -> at least 64 characters (enforced)
  realtimeSecretKeyBase: ""

  pgMetaCryptoKey: ""

  # The MQTT platform principals, each confined by a role in mosquitto/dynsec-roles.json. GENERATE
  # A DIFFERENT PASSWORD FOR EACH -- the confinement is what limits the blast radius of one leaked
  # credential, and reusing a single value throws that away. The usernames are fixed: the
  # validator's must equal the sparkplug_id generated from its pinned UUID, and the render fails
  # if it does not.
  #
  # mqttValidatorPassword is only needed with e2e.enabled -- leave it empty in production and no
  # account is created for it.
  mqttIngestionUser: aber_ingestion
  mqttIngestionPassword: ""
  mqttI3xUser: aber_i3x
  mqttI3xPassword: ""
  mqttValidatorUser: gwy110000000000400080000
  mqttValidatorPassword: ""
  mqttMonitorUser: aber_monitor
  mqttMonitorPassword: ""
  # openssl rand -hex 24. The account the credential service administers the broker's Dynamic
  # Security plugin as. REQUIRED: the broker's initContainer writes it on every start and exits
  # without it.
  mqttDynsecAdminUser: dynsec-admin
  mqttDynsecAdminPassword: ""

  # The four simulated cell gateways of the shipped `Simulated Shopfloor` flow. A production site
  # that has retired the simulator leaves these empty and gets no accounts -- but then it must also
  # reseed Node-RED with a flow that no longer declares them, or node-red-init fails closed on the
  # missing pair and Node-RED never starts.
  mqttGwCncMachiningPassword: ""
  mqttGwRoboticAssemblyPassword: ""
  mqttGwAgvFleetPassword: ""
  mqttGwFacilityBmsPassword: ""

  # openssl rand -hex 32. The bearer token supabase-functions presents to the gateway-credential
  # sidecar, and REQUIRED whenever gatewayCredential.enabled -- the render refuses below 32
  # characters, because the service refuses to start and it is a sidecar in the BROKER's pod, so
  # its refusal would take mosquitto out of Ready and stall everything waiting on it.
  #
  # ITS OWN VALUE, never shared. That service can issue a Mosquitto account for any edge node, and
  # the gateway's role turns an account into the ability to publish telemetry as that gateway -- so
  # a token reused elsewhere means one leak grants forgery across the site.
  mqttCredentialServiceToken: ""

  # The forge administrator (roadmap 7-9), and the only account Gitea is meant to have. Empty
  # stops the gitea-init container rather than creating one with a blank password.
  giteaAdminPassword: ""
  # The machine account enroll-gateway authenticates as to create a gateway repository and attach
  # its deploy key. Empty leaves the forge integration off.
  giteaMachinePassword: ""
  # The forge's door (0094). NEEDED, unlike Studio's pair: the gitea route is on by default and
  # publishes the gateway's forge listener, which is the only web login the forge has. Empty is a
  # forge every browser meets a login it cannot complete at -- appliances and enroll-gateway are
  # unaffected. openssl rand -hex 32, both.
  giteaOAuthClientSecret: ""
  giteaProxyHmacSecret: ""
  # The push webhook's signing secret (0095). openssl rand -hex 32. Empty registers no hook.
  giteaWebhookSecret: ""

  grafanaAdminUser: admin
  grafanaAdminPassword: ""
  grafanaOAuthClientSecret: ""

  # Studio's door. NEEDED ONLY IF `ingress.routes.studio` is turned on -- that route publishes the
  # gateway's studio listener, which runs an OAuth flow and admits `Administrator` alone, and the
  # render fails naming these two rather than publishing a login nobody can complete. Left empty
  # here because the route is off by default and a console on a public hostname is a decision.
  #
  # openssl rand -hex 32, both. The first is one credential in two places (the gateway presents it,
  # migration 0081 stores its hash); the second signs the session cookie and is nothing else's.
  studioOAuthClientSecret: ""
  studioProxyHmacSecret: ""

  noderedCredentialSecret: ""
  noderedOAuthClientSecret: ""
  # openssl rand -hex 32. A SIGNING key, not a bearer credential -- /hooks/quarantine is an
  # `http in` node, so any flow author can read msg.req.headers.
  noderedWebhookJwtSecret: ""
  # LEAVE EMPTY. Break-glass static token that bypasses Supabase Auth entirely.
  noderedAdminToken: ""

# ---------------------------------------------------------------------------------------------
# The two identities a site names once, and cannot comfortably change afterwards.
# ---------------------------------------------------------------------------------------------
# Both reach outside this chart: they go into the configuration of equipment it never sees, and
# into the address of every message and row already written. Neither is a preference.
ingestion:
  # REQUIRED -- the render fails while it is empty. The Sparkplug primary host application whose
  # `spBv1.0/STATE/<id>` every gateway on site watches to learn whether its consumer is there.
  primaryHostId: ""
  # REQUIRED -- the render fails while it is empty. The Sparkplug group: the second segment of every
  # topic this site publishes. Name the site's own BEFORE the first install: db-init refuses a later
  # boot whose value differs, because changing it re-addresses every gateway and all existing history.
  sparkplugGroup: ""

# publicUrls are derived from global.publicBaseDomain unless set. Override only when a service
# lives somewhere that does not follow the pattern.
publicUrls:
  frontend: ""
  supabase: ""
  # M3. Feeds the OAuth client's redirect_uris AND Grafana's GF_SERVER_ROOT_URL from one value.
  # Changing it re-registers the client on the next `helm upgrade`, because db-init is a
  # post-upgrade hook.
  grafana: ""
  nodered: ""

timescaledb:
  persistence:
    size: 200Gi
    # The historian grows with fleet size and retention, not with usage. Size it against
    # `retention.retainFor` below, not against today's row count -- and note that `never` makes
    # this a running cost rather than a ceiling.
    storageClass: ""
  # SET THIS DELIBERATELY BEFORE CARRYING PRODUCTION TELEMETRY. `retainFor` is a hard delete with
  # no undo: TimescaleDB drops whole chunks and nothing in this chart copies them anywhere first,
  # so the backup CronJob does not protect data the retention policy has already removed.
  # Traceability obligations in manufacturing commonly run to years; the 90-day default is a
  # starting point that no one has yet applied a requirement to.
  retention:
    compressAfter: "7 days"
    retainFor: "90 days"
  resources:
    requests:
      cpu: 500m
      memory: 2Gi
    limits:
      memory: 8Gi

supabaseDb:
  persistence:
    size: 50Gi
    storageClass: ""
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      memory: 8Gi

# ---------------------------------------------------------------------------------------------
# Hardening (Phase 7). All four are OFF in the chart's defaults and should be ON here.
# ---------------------------------------------------------------------------------------------

# M4. Default-deny both directions. THE TWO NAMESPACE VALUES CANNOT BE INFERRED and getting either
# wrong produces a stack where every pod is healthy and nothing reaches anything -- so set them
# against your cluster before enabling, and roll it out to a staging namespace first.
networkPolicy:
  enabled: true
  dnsNamespace: kube-system
  # kube-system for k3s's bundled Traefik; ingress-nginx usually has its own namespace.
  ingressControllerNamespace: kube-system
  # NARROW THIS, but know what it is worth: traffic arrives SNAT'd by ServiceLB, so with a narrowed
  # CIDR the source seen is the NODE's, not the gateway's. `mosquitto.tls` below is the control that
  # actually encrypts the fleet's credentials in flight; this is defence in depth behind it.
  mqttAllowedCidrs:
    - 10.0.0.0/8
  # Your service CIDR, so the e2e Job's kubectl call is not permitted to reach the whole internet.
  apiServerCidr: 10.43.0.0/16
  # Flows the chart cannot express: an SMTP relay for GoTrue, the ESO webhook, an S3 endpoint for
  # backups, a corporate proxy.
  extraEgress: {}
  # ---------------------------------------------------------------------------------------
  # The INGRESS half. With the chart's own stack (observability.enabled, the default) every
  # scrape is a generated edge and this rule is unnecessary; it is ACTIVE here for a cluster
  # Prometheus, because the alternative is the failure it exists to prevent.
  #
  # The generated rules only cover flows BETWEEN COMPONENTS OF THIS CHART. An external
  # Prometheus is not one of them, so under default-deny every scrape is dropped: its targets
  # all go DOWN, the dashboards empty, and the stack itself reports perfectly healthy
  # throughout. It reads as a monitoring fault, and the cause is three layers away.
  #
  # THE PORTS ARE THE METRICS ENDPOINTS the ServiceMonitors name (templates/obs/servicemonitors.yaml):
  #   3000  grafana, natively
  #   9901  supabase-envoy's admin listener (requires supabaseEnvoy.metrics.enabled). Envoy serves
  #         /ready AND /stats/prometheus from this one port.
  #   9234  the mosquitto exporter sidecar (requires mosquitto.metrics.enabled)
  #
  # CHANGE THE NAMESPACE to wherever your Prometheus runs. `monitoring` is the convention;
  # kube-prometheus-stack's own chart default is its release namespace. The label
  # `kubernetes.io/metadata.name` is set automatically by Kubernetes on every namespace, so no
  # labelling of your monitoring namespace is required.
  #
  # A kubelet-probe allow belongs here too, if your CNI does not exempt them (k3s's default
  # controller, Calico and Cilium all do) -- add an ipBlock for the node CIDR to the `from` list.
  # ---------------------------------------------------------------------------------------
  extraIngress:
    podSelector:
      matchLabels:
        app.kubernetes.io/part-of: aber
    policyTypes: [Ingress]
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: monitoring
        ports:
          - protocol: TCP
            port: 3000
          - protocol: TCP
            port: 9901
          - protocol: TCP
            port: 9234

# ---------------------------------------------------------------------------------------------
# TLS. Requires cert-manager AND `kubectl apply -f deploy/k8s/internal-ca.yaml` FIRST -- the CA is
# deliberately not chart-managed, because `helm uninstall` must not be able to delete the root
# private key. See the TLS section of deploy/k8s/README.md.
#
# `global.scheme: https` above is what makes this mandatory rather than optional: every
# browser-facing URL and every OAuth redirect_uri is composed from it, so advertising https while
# terminating no TLS leaves sign-in working only behind an external terminator that also speaks it.
# ---------------------------------------------------------------------------------------------
ingress:
  enabled: true
  tls:
    enabled: true
    secretName: aber-tls
    certManager:
      # `aber-ca` is the internal CA. Swap for an ACME issuer (letsencrypt-prod) ONLY if the
      # domain is genuinely public -- ACME cannot validate an internal one at all.
      clusterIssuer: aber-ca

# TLS to both databases, from the same issuer. Every client verifies the server; each database
# refuses plaintext from anything but its own loopback.
postgresTls:
  enabled: true
  clusterIssuer: aber-ca

mosquitto:
  tls:
    enabled: true
    clusterIssuer: aber-ca
    # ==========================================================================================
    # SET THIS TO THE BROKER'S EXTERNAL ADDRESS. Gateways dial the broker by IP, and a certificate
    # without an IP SAN fails verification on every one of them while the in-cluster clients --
    # which use the name `mosquitto` -- verify perfectly. The stack reports healthy, the host-run
    # gateways keep producing telemetry, and the fleet is silently off.
    #
    #   kubectl -n aber get svc mosquitto-external \
    #     -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
    #
    # The chart refuses to render a LoadBalancer deployment with no external identity at all.
    # ==========================================================================================
    extraIpSans:
      - 10.0.0.50
    # The chart's default, stated: every in-cluster client verifies the broker over 8883 and FAILS
    # CLOSED if the CA is unreadable.
    internalClients: true
  external:
    # LEAVE THIS TRUE UNTIL EVERY GATEWAY IS ON 8883. Setting it false withdraws plaintext 1883 from
    # the external Service, and a Sparkplug device that cannot connect looks, at the dashboard,
    # exactly like one that is switched off. Migrate the fleet first, then flip it. Once flipped,
    # with internalClients above, the broker's 1883 listener binds to loopback: the end state.
    plaintext: true
  metrics:
    # Runs an exporter sidecar subscribing to $SYS -- Mosquitto has no HTTP metrics surface of its
    # own. Metrics are prefixed `broker_`, NOT `mosquitto_`; alerts written against the latter
    # match nothing and fail silently.
    enabled: true

# ---------------------------------------------------------------------------------------------
# Self-monitoring. NEEDS THE PROMETHEUS OPERATOR CRDs INSTALLED FIRST -- ServiceMonitor is not a
# core Kubernetes type, so with them absent `helm install` fails with `no matches for kind
# "ServiceMonitor"` rather than skipping the objects.
#
# The per-component switches are what make the targets real: Envoy serves no metrics until its
# admin listener is on (see supabaseEnvoy below), and Mosquitto needs the sidecar above. Grafana
# needs neither -- it serves /metrics natively.
# ---------------------------------------------------------------------------------------------
telemetry:
  serviceMonitor:
    enabled: true
    # MUST MATCH your Prometheus's serviceMonitorSelector or the objects are created and silently
    # ignored -- no target, no error. Check with:
    #   kubectl get prometheus -A -o jsonpath='{.items[*].spec.serviceMonitorSelector}'
    labels:
      release: kube-prometheus-stack
    interval: 30s
    scrapeTimeout: 10s

# ---------------------------------------------------------------------------------------------
# 3D model durability. These objects are in NO database dump, and devices.model_3d_path -- which IS
# dumped -- points at them, so restoring the databases alone leaves rows referencing objects that
# are gone and AAS shells exporting dead File URLs.
#
# Pick ONE of the two routes. Velero (or a CSI snapshotter) is the better answer where it exists;
# backup.includeStorage is for stacks with neither.
# ---------------------------------------------------------------------------------------------
supabaseStorage:
  persistence:
    # A REPLICATED CLASS MATTERS MOST HERE of all the PVCs, because this one has no second copy in
    # the nightly dump.
    storageClass: longhorn
  # Velero reads this from the POD and resolves it against the pod's volume NAMES. The volume is
  # `data`. A name Velero cannot resolve is skipped and the backup still reports SUCCESS.
  podAnnotations: {}
  #  backup.velero.io/backup-volumes: data

podDisruptionBudgets:
  enabled: true
  maxUnavailable: 1

# Needs metrics-server. Only the four stateless components may be listed -- the chart refuses the
# rest, because scaling them corrupts data silently rather than failing.
autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 6
  targetCPUUtilizationPercentage: 70
  # Naming a workload the chart does not render is refused by hpas.yaml rather than rendering
  # nothing.
  components: [supabase-rest, supabase-envoy, supabase-functions, frontend]

# THE ONLY RECOVERY PATH THIS STACK HAS: local-path is node-local with no replication, and neither
# database is replicated. A logical dump recovers to the last nightly run and no finer -- for a real
# RPO this wants pgBackRest or WAL archiving, which is a larger piece of work. This is the floor.
#
# TEST A RESTORE. An untested backup is a belief, not a capability, and the failure mode here is
# discovering at the worst moment that the dumps were empty or missing the role scaffolding the RLS
# policies reference.
backup:
  enabled: true
  schedule: "30 2 * * *"
  retentionDays: 30
  # s3 needs an image carrying the aws CLI -- the supabase/postgres image has none, and the Job
  # refuses rather than silently producing an unsigned request. pvc is the default for that reason.
  destination: pvc
  persistence:
    size: 100Gi
    storageClass: ""

# Multi-replica for the stateless tier, so the PDBs above have something to protect.
#
# NOTE THESE ARE THE ONLY DEFINITIONS OF THESE KEYS IN THIS FILE. A duplicate top-level key in YAML
# does not merge and does not warn -- the last one wins outright, so a second `supabaseEnvoy:` block
# elsewhere would silently discard everything set here, or vice versa. Keep each component in one
# place; that is why the gateway's metrics switch is here rather than beside the telemetry block it
# serves.
supabaseRest:      { replicas: 2 }
supabaseFunctions: { replicas: 2 }
frontend:          { replicas: 3 }

supabaseEnvoy:
  replicas: 2
  metrics:
    # THE SINGLE MOST VALUABLE SCRAPE IN THE STACK. Every REST, Auth, Storage, Realtime and edge
    # function request passes through the gateway, and it is the only place they can be counted
    # together and labelled per upstream. PostgREST has since grown metrics of its own and is
    # scraped separately, which narrows this target's claim without displacing it: Auth, Storage,
    # Realtime and the edge runtime are still visible here and nowhere else.
    enabled: true
