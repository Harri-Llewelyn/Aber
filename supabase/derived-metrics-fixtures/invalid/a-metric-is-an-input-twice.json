{
  "about": "One metric twice in a sum, added and taken away, which only the function sees.",
  "path": "$[0].inputs[1].metric",
  "database": true,
  "document": [
    {
      "name": "Test_0297_Guard/New_Sum",
      "kind": "sum",
      "inputs": [
        {
          "metric": "@PHASE_A@",
          "sign": 1
        },
        {
          "metric": "@PHASE_A@",
          "sign": -1
        }
      ]
    }
  ]
}
