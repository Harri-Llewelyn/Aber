{
  "about": "Numbers of any sign.",
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "above": -12.5,
          "for": "0s"
        },
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "for": "5m",
          "below": 0.001
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ]
    }
  ]
}
