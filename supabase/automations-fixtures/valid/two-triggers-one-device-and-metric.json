{
  "about": "A warning band and a limit on one reading.",
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "above": 80,
          "for": "5m"
        },
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "above": 95,
          "for": "1m"
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ]
    }
  ]
}
