{
  "about": "Each device of a list is its own row.",
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": [
            "@DEVICE_A@",
            "@DEVICE_B@"
          ],
          "metric": "@METRIC@",
          "above": 80,
          "for": "5m"
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ]
    }
  ]
}
