{
  "about": "The example in the issue.",
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "above": 80,
          "for": "5m"
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ],
      "description": "Bearing above 80 for five minutes. Check the coolant feed first.",
      "enabled": true
    }
  ]
}
