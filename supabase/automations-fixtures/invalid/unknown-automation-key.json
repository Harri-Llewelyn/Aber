{
  "about": "Home Assistant's `mode:` means nothing here, and is refused.",
  "path": "$[0].mode",
  "database": false,
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "above": 80,
          "for": "5m"
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ],
      "mode": "single"
    }
  ]
}
