{
  "about": "An action is a mapping.",
  "path": "$[0].actions[0]",
  "database": false,
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "above": 80,
          "for": "5m"
        }
      ],
      "actions": [
        "alert"
      ]
    }
  ]
}
