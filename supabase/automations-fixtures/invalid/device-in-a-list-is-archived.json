{
  "about": "One device of a list is archived.",
  "path": "$[0].triggers[0].device[1]",
  "database": true,
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": [
            "@DEVICE_A@",
            "@DEVICE_ARCHIVED@"
          ],
          "metric": "@METRIC@",
          "above": 80,
          "for": "5m"
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ]
    }
  ]
}
