{
  "about": "A key a threshold trigger does not take.",
  "path": "$[0].triggers[0].variables",
  "database": false,
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC@",
          "above": 80,
          "for": "5m",
          "variables": {
            "x": 1
          }
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ]
    }
  ]
}
