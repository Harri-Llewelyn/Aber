{
  "about": "A string metric has no threshold.",
  "path": "$[0].triggers[0].metric",
  "database": true,
  "document": [
    {
      "id": "lathe-3-spindle-hot",
      "alias": "Lathe 3 spindle bearing hot",
      "triggers": [
        {
          "trigger": "threshold",
          "device": "@DEVICE_A@",
          "metric": "@METRIC_TEXT@",
          "above": 80,
          "for": "5m"
        }
      ],
      "actions": [
        {
          "action": "alert",
          "severity": "warning"
        }
      ]
    }
  ]
}
