      "expected": [
        {"metric": "Q", "code": "pattern_mismatch", "detail": "schema requires a match for ^a$", "observed_type": "string", "dropped": false, "pattern": "^a$", "enforced": true}
      ]
    },
    {
      "name": "a metric named only in required is modelled with no constraint",
      "schema_definitions": [
