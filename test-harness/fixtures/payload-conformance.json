        {"properties": {"P": {"pattern": "^a$"}, "Q": {"pattern": "^a$"}}},
        {"properties": {"P": {"pattern": "^b$"}, "Q": {"pattern": "^a$"}}}
      ],
      "observed": [
        ["P", "string", "c"],
        ["Q", "string", "c"]
