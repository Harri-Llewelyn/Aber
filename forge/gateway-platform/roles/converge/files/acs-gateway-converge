#!/bin/bash
# Converge this appliance to the platform tag its own repository names.
#
# Reads platform.yml from the puller's checkout of the gateway's main, runs ansible-pull against
# the platform repository at that tag with the appliance's own deploy key and the forge's pinned
# host key, then runs this gateway's own custom.yml if its repository carries one, and records both
# results where the puller will push them to the appliance branch. Every path here is what
# bootstrap.mjs wrote under /data, reached through the bind mount the appliance role sets up.
# Outbound only, verified, no inventory.
#
# The custom playbook runs from the puller's checkout, which is at the head of the tracked branch
# whatever the puller decided about the flow: a flow refused for its shape does not hold the
# checkout back, because what is on main is what was approved either way.
set -u

STATE_DIR=${ACS_STATE_DIR:-/var/lib/acs-gateway}
DATA_DIR=${ACS_DATA_DIR:-$STATE_DIR/data}
COMPOSE_DIR=${ACS_COMPOSE_DIR:-/opt/acs-gateway}
GITOPS="$DATA_DIR/gitops"
KEY="$GITOPS/id_ed25519"
KNOWN_HOSTS="$GITOPS/known_hosts"
REPOSITORY="$GITOPS/repository.json"
REPO_DIR="$GITOPS/repo"
POINTER="$REPO_DIR/platform.yml"
CUSTOM="$REPO_DIR/custom.yml"
CONVERGED="$GITOPS/converged.json"
CHECKOUT="$STATE_DIR/platform"

# What this gateway's own playbook did, as a JSON value. `null` means it has not run: either the
# repository carries none, or the platform run failed before it could.
CUSTOM_RECORD=null

log() { echo "[acs-gateway-converge] $*"; }

record() {
  # $1 outcome, $2 tag, $3 detail. Read by nothing on this box; pushed by flow-sync.mjs.
  jq -n --arg outcome "$1" --arg tag "$2" --arg detail "$3" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson custom "$CUSTOM_RECORD" \
    '{outcome: $outcome, tag: $tag, detail: $detail, converged_at: $at, custom: $custom}' > "$CONVERGED.tmp" \
    && mv "$CONVERGED.tmp" "$CONVERGED"
}

custom_record() {
  # $1 outcome, $2 revision, $3 detail. Kept separate from the platform's outcome above, so a
  # gateway's own broken playbook is never read as the platform failing to converge.
  jq -n --arg outcome "$1" --arg revision "$2" --arg detail "$3" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{outcome: $outcome, revision: $revision, detail: $detail, ran_at: $at}'
}

# This gateway's own playbook, beside its flow on the branch an administrator approved. Every
# gateway runs the platform playbook; "custom" is a gateway whose repository also carries one.
# Run after the platform's and never instead of it, because the platform is what puts Docker, the
# compose project and the directories below in place.
run_custom() {
  if [ ! -f "$CUSTOM" ]; then
    log "$REPO_DIR holds no custom.yml; this gateway runs the platform playbook alone"
    return 0
  fi

  local revision paths rc
  revision=$(git -c safe.directory="$REPO_DIR" -C "$REPO_DIR" rev-parse HEAD 2>/dev/null) || revision=""

  # Where the platform put things, so a custom playbook states no path of its own. After the
  # gateway's own vars, so these cannot be overridden by the file being run. `-c` because this
  # becomes one command-line argument, and jq prints an object over several lines by default.
  paths=$(jq -c -n --arg state "$STATE_DIR" --arg data "$DATA_DIR" --arg compose "$COMPOSE_DIR" \
    --arg repo "$REPO_DIR" --arg tag "$TAG" \
    '{acs_state_dir: $state, acs_data_dir: $data, acs_compose_dir: $compose, acs_repo_dir: $repo, acs_platform_tag: $tag}')

  log "running this gateway's own custom.yml at ${revision:-an unknown revision}"
  # From the checkout, so roles/, files/ and templates/ beside custom.yml resolve.
  ( cd "$REPO_DIR" && ansible-playbook --inventory localhost, \
      --extra-vars "$EXTRA" --extra-vars "$paths" custom.yml )
  rc=$?

  if [ "$rc" -eq 0 ]; then
    CUSTOM_RECORD=$(custom_record converged "$revision" "custom.yml succeeded")
    log "this gateway's custom.yml converged"
    return 0
  fi
  CUSTOM_RECORD=$(custom_record failed "$revision" "custom.yml exited $rc")
  log "this gateway's custom.yml exited $rc; the platform convergence above stands"
  return "$rc"
}

for f in "$KEY" "$KNOWN_HOSTS" "$REPOSITORY"; do
  if [ ! -f "$f" ]; then
    log "REFUSING: $f does not exist; this appliance is not enrolled, or its data is not under $DATA_DIR"
    exit 1
  fi
done

PLATFORM_URL=$(jq -r '.platform_ssh_url // empty' "$REPOSITORY")
if [ -z "$PLATFORM_URL" ]; then
  log "REFUSING: $REPOSITORY names no platform_ssh_url; the platform had no platform repository when this appliance enrolled. Re-enrol, or add it by hand."
  exit 1
fi

# The tag: platform.yml on main, which the puller keeps current; the tag enrolment recorded until
# the first pull. Extra variables ride on the same file.
TAG=""
EXTRA="{}"
if [ -f "$POINTER" ]; then
  TAG=$(python3 -c 'import sys, yaml; d = yaml.safe_load(open(sys.argv[1])) or {}; print((d.get("platform") or {}).get("tag") or "")' "$POINTER" 2>/dev/null)
  # Assigned only when it parsed. The pointer is changed by pull request, so it can arrive
  # unparseable; a failed read would otherwise replace the declared default with the empty string
  # and pass that to ansible-pull as its extra variables.
  POINTER_VARS=$(python3 -c 'import sys, json, yaml; d = yaml.safe_load(open(sys.argv[1])) or {}; print(json.dumps((d.get("platform") or {}).get("vars") or {}))' "$POINTER" 2>/dev/null)
  if [ -n "$POINTER_VARS" ]; then EXTRA="$POINTER_VARS"; fi
fi
if [ -z "$TAG" ]; then
  TAG=$(jq -r '.platform_tag // empty' "$REPOSITORY")
fi
if [ -z "$TAG" ]; then
  log "REFUSING: no platform tag: $POINTER names none and $REPOSITORY holds none"
  record refused "" "no platform tag named"
  exit 1
fi

export GIT_SSH_COMMAND="ssh -i $KEY -o IdentitiesOnly=yes -o UserKnownHostsFile=$KNOWN_HOSTS -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10"
export GIT_TERMINAL_PROMPT=0
export ANSIBLE_LOCALHOST_WARNING=false

log "converging to $TAG from $PLATFORM_URL"
ansible-pull --url "$PLATFORM_URL" --checkout "$TAG" --directory "$CHECKOUT" --purge \
  --inventory localhost, --extra-vars "$EXTRA" site.yml
rc=$?

if [ "$rc" -ne 0 ]; then
  # custom.yml is not attempted, and CUSTOM_RECORD stays null: a gateway's own playbook run
  # without the platform underneath it would fail for the platform's reason and report its own.
  record failed "$TAG" "ansible-pull exited $rc"
  log "ansible-pull exited $rc; recorded, and the timer will try again"
  exit $rc
fi
log "converged to $TAG"

run_custom
custom_rc=$?

# The platform's outcome is what it was, whatever this gateway's own playbook did. The exit status
# is not: a failing custom.yml has to reach the unit's status, or the only record of it is a field
# in the forge nobody is watching.
record converged "$TAG" "ansible-pull succeeded"
exit $custom_rc
