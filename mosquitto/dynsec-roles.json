{
  "defaultACLAccess": {
    "publishClientSend": false,
    "publishClientReceive": false,
    "subscribe": false,
    "unsubscribe": true
  },
  "roles": [
    {
      "rolename": "admin",
      "textDescription": "The credential service. Speaks to the plugin and reads nothing else.",
      "acls": [
        { "acltype": "publishClientSend", "topic": "$CONTROL/dynamic-security/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "$CONTROL/dynamic-security/#", "allow": true },
        { "acltype": "subscribePattern", "topic": "$CONTROL/dynamic-security/#", "allow": true }
      ]
    },
    {
      "rolename": "gateway",
      "textDescription": "Every gateway. Subscribing is granted across spBv1.0/ so wildcard subscriptions succeed; what is delivered is decided by the gateway's own role, plus the primary-host STATE topics here.",
      "acls": [
        { "acltype": "subscribePattern", "topic": "spBv1.0/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "spBv1.0/STATE/#", "allow": true }
      ]
    },
    {
      "rolename": "ingestion",
      "textDescription": "The ingestion daemon: reads every Sparkplug topic, publishes only rebirth NCMDs, and is the only writer of the Directory and the Unified Namespace. It is also the site primary host application; its write on spBv1.0/STATE/<host_id> is ONE literal topic injected at reconcile time from PRIMARY_HOST_ID, because the host id is named by the deployment and not by this file.",
      "acls": [
        { "acltype": "subscribePattern", "topic": "spBv1.0/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "spBv1.0/#", "allow": true },
        { "acltype": "publishClientSend", "topic": "spBv1.0/+/NCMD/+", "allow": true },
        { "acltype": "publishClientSend", "topic": "ACS-Cymru/Directory/#", "allow": true },
        { "acltype": "subscribePattern", "topic": "ACS-Cymru/Directory/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "ACS-Cymru/Directory/#", "allow": true },
        { "acltype": "publishClientSend", "topic": "uns/#", "allow": true },
        { "acltype": "subscribePattern", "topic": "uns/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "uns/#", "allow": true }
      ]
    },
    {
      "rolename": "i3x",
      "textDescription": "The i3X server: reads the whole namespace and the Directory, publishes nothing.",
      "acls": [
        { "acltype": "subscribePattern", "topic": "spBv1.0/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "spBv1.0/#", "allow": true },
        { "acltype": "subscribePattern", "topic": "ACS-Cymru/Directory/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "ACS-Cymru/Directory/#", "allow": true }
      ]
    },
    {
      "rolename": "monitor",
      "textDescription": "The health probes and the metrics exporter: $SYS only.",
      "acls": [
        { "acltype": "subscribePattern", "topic": "$SYS/#", "allow": true },
        { "acltype": "publishClientReceive", "topic": "$SYS/#", "allow": true }
      ]
    }
  ]
}
