// =============================================================================================
// Grafana Alloy -- the collector that ships container logs to Loki.
//
// A log store needs something to PUT logs in it, and the daemon
// pushing its own would miss the case this exists for: incidents.md's first entry
// is a broker password truncated in one container and only visible from another, hours later.
// Mosquitto's lines are the ones that story needs, and only a collector gets them.
//
// -----------------------------------------------------------------------------------------------
// WHY THIS TALKS TO A PROXY AND NOT TO /var/run/docker.sock
// -----------------------------------------------------------------------------------------------
// Alloy discovers containers through the Docker API, and the obvious way to give it that is to
// mount the socket. NOTHING IN THIS REPOSITORY MOUNTS THAT SOCKET, and it should stay that way:
// it is a root-equivalent grant -- create, start, exec, and a bind mount of the host filesystem
// into a new container. The stack that removed `--web.enable-lifecycle` from Prometheus because
// it exposed a remote shutdown on an unauthenticated port does not then hand out the socket to
// label some log lines.
//
// So it goes through docker-socket-proxy, which allowlists the API by path: `CONTAINERS=1` and
// every write verb off. The reachable surface is enumerable, it is enumerated in
// docker-compose.yml, and the proxy publishes no host port -- only this container's network can
// reach it.
//
// THE SOCKETLESS ALTERNATIVE WAS TRIED ON PAPER AND REJECTED. Reading
// /var/lib/docker/containers/*/*-json.log read-only needs no proxy and no privilege at all, but
// the only identity in that path is the container ID, which changes on every recreate and names
// nothing a human recognises. "Which container was this" is the question the store exists to
// answer, so a design that answers it with a hex string fails at the thing it is for.
// =============================================================================================

logging {
	// WARN, for the same reason loki.yaml sets it: Alloy's own stdout is collected by Alloy, so an
	// info-level default writes about writing, forever.
	level  = "warn"
	format = "logfmt"
}

// ---------------------------------------------------------------------------------------------
// Discovery -- through the proxy, never the socket.
// ---------------------------------------------------------------------------------------------
discovery.docker "compose" {
	host             = "tcp://docker-socket-proxy:2375"
	refresh_interval = "15s"
}

// ---------------------------------------------------------------------------------------------
// LABELS ARE DELIBERATELY TWO, AND THIS IS THE MOST IMPORTANT DECISION IN THE FILE.
//
// Loki indexes by label combination: every distinct set is a stream, with its own index entry and
// its own chunks. That makes the label set a cardinality budget, and the rule is the one
// metrics.py already states for Prometheus -- "CARDINALITY IS BOUNDED BY DESIGN. The only label
// in use is `edge_node` ... Labelling by DEVICE would be unbounded."
//
// The same trap is sharper here, because the lines now CARRY the tempting fields. ingestion.py
// logs `reason`, `device` and `edge_node` as structured JSON, and promoting `device` to a label
// would mint one stream per machine on the plant and degrade the index for everything else.
//
// SO THE FIELDS STAY FIELDS AND ARE QUERIED AT READ TIME:
//
//     {service="ingestion"} | json | reason = "gateway_binding"
//
// That is the drill-down from the Prometheus panel showing
// acs_ingestion_messages_dropped_total{reason="gateway_binding"}, and it works because
// test_structured_logging.py asserts the label and the logged field are the same string. It is a
// filter expression rather than an index lookup, which over a 30-day window on one host is the
// right trade and over a fleet would not be.
//
// `service` and `container` are 1:1 here, so carrying both multiplies nothing: `service` is what
// the compose file calls it and what a query should say, `container` is what `docker logs` and
// `docker ps` call it, and an operator moving between the two should not have to translate.
// ---------------------------------------------------------------------------------------------
discovery.relabel "compose" {
	targets = discovery.docker.compose.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	// Docker reports container names with a leading slash. Stripped here rather than tolerated,
	// because `container="/acs-cymru_mosquitto"` does not match what `docker ps` prints and the
	// mismatch is the sort a person retypes three times before noticing.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/?(.*)"
		target_label  = "container"
	}

	// ANYTHING NOT STARTED BY THIS COMPOSE PROJECT IS DROPPED. The proxy lists every container on
	// the host, which on a developer's machine is other people's work -- collecting it would fill
	// this store with logs that are not ours and are not wanted.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = ".+"
		action        = "keep"
	}
}

// ---------------------------------------------------------------------------------------------
// Collection.
// ---------------------------------------------------------------------------------------------
loki.source.docker "compose" {
	host             = "tcp://docker-socket-proxy:2375"
	targets          = discovery.relabel.compose.output
	forward_to       = [loki.process.compose.receiver]
	refresh_interval = "15s"
}

loki.process "compose" {
	forward_to = [loki.write.local.receiver]

	// THE LINE IS FORWARDED WHOLE AND UNPARSED, and that is the point rather than an omission.
	//
	// A `stage.json` here would have to cope with a stream that is JSON from ingestion, capture and
	// playback, and plain text from mosquitto, Envoy, Node-RED, Grafana and Postgres -- so it would
	// spend most of its time failing on lines that were never malformed. Parsing at query time
	// costs nothing when the parse is not attempted, and `| json` is applied only by a query that
	// knows it is reading a JSON stream.
	//
	// It also keeps ONE property that matters more than convenience: what the store holds is
	// byte-for-byte what the container printed. A collector that reshapes lines on the way in makes
	// the store's copy a different artefact from the one an engineer sees in `docker logs`, and
	// incidents.md is a record of faults diagnosed by comparing exactly those two things.

	// -------------------------------------------------------------------------------------------
	// REJOINING TRACEBACKS, CONFINED TO THE TWO SERVICES WHOSE FORMAT THIS REPOSITORY CONTROLS.
	//
	// Multi-line Python tracebacks arrive as one Docker log entry per LINE, which turns a single
	// exception into eight unrelated-looking records -- the one naming the error separated from the
	// one naming the code. This rejoins them: a line that does not start with a timestamp or a `{`
	// belongs to the record above it.
	//
	// THE `stage.match` IS NOT DECORATION, AND THE SEMANTICS BEHIND IT WERE MEASURED RATHER THAN
	// ASSUMED. `stage.multiline` opens a block when a line MATCHES `firstline`, and appends every
	// following non-matching line to it. A stream where nothing ever matches is therefore left
	// alone -- which is why mosquitto's epoch-prefixed lines and node-exporter's logfmt looked
	// unaffected when this was first checked, and why that observation proved nothing.
	//
	// THE HAZARD IS A MIXED STREAM. One line that happens to start with `{` or an ISO date opens a
	// block, and every unrelated line printed after it is swallowed into that record -- up to 200
	// of them -- filed under the FIRST line's timestamp. Several services here emit JSON some of
	// the time (the Supabase components especially), so this was reachable in normal operation and
	// would have shown up as lines going missing rather than as an error.
	//
	// It also broke the promise three comments up: what the store holds is supposed to be
	// byte-for-byte what the container printed. That holds for every service outside this selector
	// now, because nothing touches them.
	//
	// `ingestion` and `playback` are the two that emit `logging_config.py`'s formats, so they are
	// the two whose lines this regex can actually describe. Anything added to the selector needs a
	// `firstline` that describes ITS format too, not this one.
	// -------------------------------------------------------------------------------------------
	stage.match {
		selector = "{service=~\"ingestion|playback\"}"

		stage.multiline {
			firstline     = "^(\\{|\\d{4}-\\d{2}-\\d{2}T)"
			max_wait_time = "3s"
			max_lines     = 200
		}
	}
}

// ---------------------------------------------------------------------------------------------
// Delivery.
//
// NO CREDENTIAL AND NO TENANT HEADER, matching loki.yaml's `auth_enabled: false`. Loki is
// reachable only on the compose network and publishes nothing to the host -- the same posture,
// and the same reasoning, as Grafana's Prometheus datasource.
// ---------------------------------------------------------------------------------------------
loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"

		// Loki answers 429 when a burst exceeds `ingestion_rate_mb`, and this is what turns that into
		// a delay rather than a loss. The store's rate limit exists to protect the host's disk during
		// a fault; the collector's job during the same fault is to keep hold of the evidence, so it
		// waits rather than discarding. Beyond the last retry the tail of the flood is dropped, which
		// is the failure that was chosen -- see loki.yaml.
		max_backoff_period  = "5m"
		max_backoff_retries = 20
	}

	// The write-ahead log is what makes an Alloy restart lossless. Without it, everything buffered
	// in memory at `docker compose restart alloy` is gone -- and a collector is most likely to be
	// restarted during the incident whose logs are worth keeping.
	wal {
		enabled = true
	}
}
