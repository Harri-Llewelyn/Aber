{
  "uid": "acs-cymru-shopfloor",
  "title": "Manufacturing Cells & Telemetry Overview",
  "tags": [
    "acs-cymru",
    "shopfloor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Four standards on one floor. Every metric name here is registered in `metric_catalog` with its standard and published semantic id (migrations 0018, 0019) -- the panels use the REGISTERED spellings, e.g. BMS/ZONE_TEMPERATURE and OEE/OEE, because a name published outside the catalog creates a series with no provenance.",
  "panels": [
    {
      "type": "row",
      "title": "Cell 1 — Precision Machining (MTConnect 2.x)",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Machine Tool Thermal Trend",
      "description": "MTConnect `Systems/TEMPERATURE` across the machining cell, read from the 1-minute rollup. The thermal-fault inject drives Sim_CNC_Mill_01 to ~95 °C within one scan.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket AS \"time\", coalesce(a.asset_name, t.asset_id) AS metric,\n       sum(sum_double) / NULLIF(sum(n_double), 0) AS value\n  FROM telemetry_1m t LEFT JOIN assets a ON a.asset_id = t.asset_id\n WHERE $__timeFilter(bucket) AND t.metric_name = 'Systems/TEMPERATURE'\n GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Controller Execution State",
      "description": "MTConnect `Controller/EXECUTION`. State metrics survive the rollups as last(value) -- a rollup covering only val_double would force every state panel back onto raw. Read through telemetry_gapfill() because under RBE a missing bucket means UNCHANGED, not unknown.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket_ts AS \"time\", asset_id AS metric, val_string AS value\n  FROM telemetry_gapfill($__timeFrom()::timestamptz, $__timeTo()::timestamptz, '1 minute',\n                         NULL, ARRAY['Controller/EXECUTION'])\n WHERE val_string IS NOT NULL ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "ACTIVE": {
                  "color": "green",
                  "index": 0
                },
                "READY": {
                  "color": "blue",
                  "index": 1
                },
                "INTERRUPTED": {
                  "color": "red",
                  "index": 2
                },
                "AUTOMATIC": {
                  "color": "green",
                  "index": 3
                },
                "STOPPED": {
                  "color": "red",
                  "index": 4
                },
                "MANUAL": {
                  "color": "orange",
                  "index": 5
                },
                "ARMED": {
                  "color": "green",
                  "index": 6
                },
                "TRIGGERED": {
                  "color": "red",
                  "index": 7
                },
                "AVAILABLE": {
                  "color": "green",
                  "index": 8
                },
                "UNAVAILABLE": {
                  "color": "red",
                  "index": 9
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
