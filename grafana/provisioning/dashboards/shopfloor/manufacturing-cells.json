    {
      "id": 6,
      "type": "timeseries",
      "title": "Energy — Compressed Air Flow",
      "description": "OPC 40001-4 `Energy/VolumeFlowRate`. Compressed air rather than electrical power: the seeded 40001-4 subset models energy MEDIA (pressure, volume, flow) and carries no active-power concept, so this is the energy metric with a published semantic id behind it. Electrical power needs a vocabulary extension from the OPC NodeSet.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket AS \"time\", coalesce(a.asset_name, t.asset_id) AS metric,\n       sum(sum_double) / NULLIF(sum(n_double), 0) AS value\n  FROM telemetry_1m t LEFT JOIN assets a ON a.asset_id = t.asset_id\n WHERE $__timeFilter(bucket) AND t.metric_name = 'Energy/VolumeFlowRate'\n GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "l/s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
