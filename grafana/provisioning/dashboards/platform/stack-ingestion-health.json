{
  "uid": "aber-platform",
  "title": "Stack & Ingestion Health",
  "tags": [
    "aber",
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "What the ingestion daemon lands in the historian, and how the hypertable and its rollups grow. Reads only objects on the historian; `gateways` and `asset_config` live in Supabase.",
  "panels": [
    {
      "type": "row",
      "title": "Ingestion",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Telemetry Rows Ingested (per second)",
      "description": "Rows landing in `telemetry` per second: what was written. Messages Lost below counts what was not. A fall here with no rise there is a quiet plant; a fall here with a rise there is a fault.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT time_bucket('1 minute', time) AS \"time\",\n       'rows/sec' AS metric,\n       count(*) / 60.0 AS value\n  FROM telemetry\n WHERE $__timeFilter(time)\n GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingestion Rate by Device",
      "description": "Per-device write rate. Under report-by-exception a flat zero is a device whose values are not moving, not one that has stopped; the 5-minute keepalive is what bounds the difference.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT time_bucket('1 minute', t.time) AS \"time\",\n       coalesce(a.asset_name, t.asset_id) AS metric,\n       count(*) AS value\n  FROM telemetry t LEFT JOIN assets a ON a.asset_id = t.asset_id\n WHERE $__timeFilter(t.time)\n GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Series",
      "description": "Distinct (device, metric) pairs with a sample in the window. Bounded by series count rather than by history, which is the property `telemetry_latest` exists for.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT now() AS \"time\", 'series' AS metric,\n       count(*)::float AS value\n  FROM (SELECT DISTINCT asset_id, metric_name FROM telemetry\n         WHERE $__timeFilter(time)) s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Devices Reporting",
      "description": "Distinct devices with a sample in the window.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT now() AS \"time\", 'devices' AS metric,\n       count(DISTINCT asset_id)::float AS value\n  FROM telemetry WHERE $__timeFilter(time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rows in Hypertable",
      "description": "Raw observations retained. Raw is dropped by the retention policy while the rollups outlive it, which is what lets a question about last spring still be answered.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT now() AS \"time\", 'rows' AS metric, count(*)::float AS value\n  FROM telemetry"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Messages Lost: Refused, Shed, Missed",
      "description": "Three counts that do not add up. Refused: declined by the daemon, by reason. Shed: dropped by the broker for a slow subscriber, unseen by the daemon. Missed: inferred from Sparkplug `seq` gaps. Click a refused series for the logs, which name the device.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(broker_publish_messages_dropped[$__rate_interval]))",
          "legendFormat": "shed by the broker"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aber_ingestion_sequence_messages_missed_total[$__rate_interval])) or vector(0)",
          "legendFormat": "missed in sequence (lower bound)"
        },
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(aber_ingestion_messages_dropped_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "Which devices? Open the logs for this reason",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"loki\",\"uid\":\"loki\"},\"expr\":\"{service=\\\"ingestion\\\"} | json | reason = \\\"${__field.labels.reason}\\\"\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "normal",
                  "group": "B"
                }
              },
              {
                "id": "links",
                "value": []
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "normal",
                  "group": "C"
                }
              },
              {
                "id": "links",
                "value": []
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Gateway Outages",
      "id": 18,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Outage Readings: Buffered, Replayed, Dropped, Refused",
      "description": "What gateways could not deliver, in their own words and the daemon's. Buffered and dropped are reported by each gateway after an outage; replayed is what arrived flagged is_historical; refused is a replay older than ingestion.historicalMaxAgeSeconds. Dropped and refused readings were never recorded. See ingestion/README.md, \"Loss model\".",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (edge_node) (increase(aber_ingestion_gateway_outage_readings_dropped_total[$__rate_interval]))",
          "legendFormat": "{{edge_node}} dropped"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (edge_node) (increase(aber_ingestion_gateway_outage_readings_buffered_total[$__rate_interval]))",
          "legendFormat": "{{edge_node}} buffered"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (edge_node) (increase(aber_ingestion_historical_readings_total[$__rate_interval]))",
          "legendFormat": "{{edge_node}} replayed"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (edge_node) (increase(aber_ingestion_timestamps_rejected_total{reason=\"historical_too_old\"}[$__rate_interval]))",
          "legendFormat": "{{edge_node}} refused as too old"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Last Outage by Gateway",
      "description": "The last outage each gateway reported since the daemon started: how long, what it buffered and dropped, and whether it buffers at all. A gateway that does not buffer loses everything it reads while it cannot deliver.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aber_ingestion_gateway_outage_last_seconds",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aber_ingestion_gateway_outage_last_readings_buffered",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aber_ingestion_gateway_outage_last_readings_dropped",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aber_ingestion_gateway_outage_last_buffering",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aber_ingestion_gateway_outage_reported_timestamp_seconds * 1000",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pod": true,
              "namespace": true
            },
            "renameByName": {
              "edge_node": "Gateway",
              "Value #A": "Outage",
              "Value #B": "Buffered",
              "Value #C": "Dropped",
              "Value #D": "Buffers",
              "Value #E": "Reported"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Outage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reported"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Buffers"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no"
                      },
                      "1": {
                        "text": "yes"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dropped"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Reported",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Continuous Aggregates",
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rollup Bucket Coverage",
      "description": "Buckets materialised in each rollup. The hierarchy is 1m, 5m, 1h, each built from the one before, so a gap only in the coarser views is a refresh policy problem, not ingestion.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket AS \"time\", '1 minute' AS metric, count(*) AS value\n  FROM telemetry_1m WHERE $__timeFilter(bucket) GROUP BY 1\n UNION ALL\nSELECT bucket, '5 minute', count(*) FROM telemetry_5m\n WHERE $__timeFilter(bucket) GROUP BY 1\n UNION ALL\nSELECT bucket, '1 hour', count(*) FROM telemetry_1h\n WHERE $__timeFilter(bucket) GROUP BY 1\n ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Historian I/O by Backend",
      "description": "From pg_stat_io. `grafana_reader` holds pg_monitor, which grants visibility into the statistics views and nothing else.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT backend_type AS \"Backend\", object AS \"Object\",\n       context AS \"Context\", hits AS \"Cache hits\", reads AS \"Disk reads\"\n  FROM pg_stat_io\n WHERE hits > 0 OR reads > 0\n ORDER BY reads DESC NULLS LAST LIMIT 20"
        }
      ]
    },
    {
      "id": 10,
      "datasource": null,
      "type": "row",
      "title": "Data Lifecycle & Storage",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
    {
      "id": 11,
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "type": "stat",
      "title": "Total Stored",
      "description": "Every byte this platform holds, across both databases: the historian's hypertables and rollups over postgres_fdw, plus the Supabase public schema locally. Table, index and TOAST included.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT sum(total_bytes) AS \"Total\" FROM public.storage_footprint"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 12,
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "type": "stat",
      "title": "Audit Trail (never pruned)",
      "description": "public.audit_trail, the one relation here with no retention policy: append-only, with UPDATE and DELETE blocked since archived migration 0003, so this number only rises.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT total_bytes AS \"Audit\" FROM public.storage_footprint\n WHERE source = 'platform' AND relation = 'audit_trail'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
