        "uid": "supabase"
      },
      "type": "stat",
      "title": "Raw Telemetry Compression",
      "description": "Compressed bytes over uncompressed for the raw hypertable. Blank in two different cases: compression is off (TIMESCALE_COMPRESS_AFTER 'never'), or no chunk has aged past the policy yet. Blank is not zero.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT compressed_bytes::numeric / NULLIF(uncompressed_bytes, 0) AS \"Ratio\"\n  FROM public.storage_footprint\n WHERE tier = 'raw' AND uncompressed_bytes IS NOT NULL"
        }
      ],
      "fieldConfig": {
