        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 14,
      "datasource": {
        "type": "postgres",
        "uid": "supabase"
      },
      "type": "stat",
      "title": "Raw Retention Horizon",
      "description": "How far back raw chunks reach, from catalog boundaries rather than a scan. Should track timescaledb.retention.retainFor; well past it means retention is not running, or is waiting on the cold archive.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - oldest_data)) AS \"Age\"\n  FROM public.storage_footprint WHERE tier = 'raw'"
