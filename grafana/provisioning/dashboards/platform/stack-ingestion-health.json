          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "supabase"
          },
          "rawSql": "SELECT tier AS \"Tier\", sum(total_bytes) AS \"Bytes\"\n  FROM public.storage_footprint\n GROUP BY tier\n ORDER BY sum(total_bytes) DESC"
