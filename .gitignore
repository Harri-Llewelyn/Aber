# Environment variables
.env
!.env.example
# Written by `npm run provision:gateways -- --env-out=…`. Holds per-gateway broker passwords that
# mosquitto_passwd cannot read back, so it is a real secret and never a committed artefact.
.env.gateways

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Node / React
node_modules/
dist/
build/
.cache/

# Mosquitto generated credentials
mosquitto/password_file

# Supabase CLI local scratch
supabase/.branches/
supabase/.temp/

# Helm
#
# A filled-in production values file holds real credentials. The .example is committed and is the
# starting point; the copy never is. deploy/helm/acs-cymru/files/ IS committed on purpose --
# those are mirrored config files a packaged chart must carry, see scripts/sync-helm-chart-files.mjs.
deploy/helm/**/values-prod.yaml
deploy/helm/**/values-local.yaml
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# Generated Protobuf files
*_pb2.py
ingestion/*_pb2.py

# Logical backups written by scripts/backup-databases.sh. These are FULL DATABASE DUMPS -- they
# contain auth.users, hashed OAuth client secrets and the whole digital_thread. Never commit one.
backups/
*.sql.gz
*.dump

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
CLAUDE.md
