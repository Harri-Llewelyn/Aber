# Environment variables
.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Node / React
node_modules/
dist/
build/
.cache/

# Mosquitto generated credentials.
#
# Neither target writes here -- Compose assembles /mosquitto/config inside a named volume and
# the chart uses a Secret -- but mosquitto/ is now a real directory holding the policy files,
# so a hand-run `mosquitto_passwd -c mosquitto/password_file` while debugging lands beside them.
# That file is $7$ hashes of the five platform principals.
mosquitto/password_file

# Supabase CLI local scratch
supabase/.branches/
supabase/.temp/

# Helm
#
# A filled-in production values file holds real credentials. The .example is committed and is the
# starting point; the copy never is. deploy/helm/acs-cymru/files/ IS committed on purpose --
# those are mirrored config files a packaged chart must carry, see scripts/sync-helm-chart-files.mjs.
deploy/helm/**/values-prod.yaml
deploy/helm/**/values-local.yaml
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# Generated Protobuf files
*_pb2.py
ingestion/*_pb2.py

# Logical backups written by scripts/backup-databases.sh. These are FULL DATABASE DUMPS -- they
# contain auth.users, hashed OAuth client secrets and the whole digital_thread. Never commit one.
backups/
*.sql.gz
*.dump

# THE ONE EXCEPTION, and it is narrow on purpose.
#
# The chart carries the migration chain gzipped, one archive per file, because uncompressed it is 85%
# of the 1 MiB ConfigMap limit -- see the header of deploy/helm/acs-cymru/templates/jobs/db-init.yaml.
# Those files share the `.sql.gz` extension with the backups above and are the opposite kind of
# thing: schema and seed data, already public in supabase/migrations/, and a packaged chart is
# unusable without them.
#
# SCOPED TO THAT ONE DIRECTORY rather than relaxing the rule. `*.sql.gz` exists to stop a dump full
# of password hashes being committed by someone who ran the backup script in the repo root, and a
# broad `!*.sql.gz` anywhere would quietly retire that guard.
#
# Without this negation the archives are silently absent from a commit, and a fresh clone renders a
# chart with no migrations at all. That fails loudly -- db-init.yaml's `fail` guard refuses to
# install an empty ConfigMap -- but it fails a long way from the cause.
!deploy/helm/acs-cymru/files/migrations/*.sql.gz

# OS / IDE
.DS_Store
Thumbs.db
