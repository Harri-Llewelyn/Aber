# Node / React
node_modules/
dist/
build/
.cache/

# Mosquitto generated credentials.
#
# Nothing in the deployment writes here -- the chart mounts the policy files from a ConfigMap and
# the plugin keeps its hashes in its own document -- but mosquitto/ is a real directory holding
# those policy files, so a hand-run `mosquitto_passwd -c mosquitto/password_file` while debugging
# lands beside them.
# That file is $7$ hashes of the five platform principals.
mosquitto/password_file

# Supabase CLI local scratch
supabase/.branches/
supabase/.temp/

# Helm
#
# A filled-in production values file holds real credentials. The .example is committed and is the
# starting point; the copy never is. deploy/helm/aber/files/ IS committed on purpose --
# those are mirrored config files a packaged chart must carry, see scripts/sync-helm-chart-files.mjs.
deploy/helm/**/values-prod.yaml
deploy/helm/**/values-local.yaml
deploy/helm/**/values-try.yaml
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# Generated Protobuf files
*_pb2.py
ingestion/*_pb2.py

# Logical backups written by scripts/backup-databases.sh. These are FULL DATABASE DUMPS -- they
# contain auth.users, hashed OAuth client secrets and the whole audit_trail. Never commit one.
backups/
*.sql.gz
*.dump

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
CLAUDE.md

